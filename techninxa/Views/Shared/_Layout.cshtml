<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="@(ViewData["Description"] ?? "Techninxa — modern software, mobile, web and IoT solutions.")">
    <title>@ViewData["Title"] — Techninxa</title>
    <link rel="favicon" href="~/assets/techninxa-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="page-noise"></div>

    <!-- HEADER -->
    <header class="site-header" id="siteHeader">
        <div class="container nav-wrap">

            <a class="brand" href="/" aria-label="Techninxa home">
                <img src="~/assets/techninxa-logo.png" alt="Techninxa logo">
            </a>

            <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <nav class="main-nav" aria-label="Main navigation">
                <a class="@(ViewData["ActiveNav"] as string == "Home" ? "active" : "")" href="/">Home</a>
                <a href="/#services">Services</a>
                <a class="@(ViewData["ActiveNav"] as string == "Projects" ? "active" : "")" href="/Projects">Projects</a>
                <a href="/#about">About</a>
                <a href="/#contact">Contact</a>
            </nav>

            <a class="nav-cta" href="tel:+8801790379729">
                Let's Talk <span>↗</span>
            </a>

        </div>
    </header>

    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container footer-top">

            <div class="footer-brand">
                <img src="~/assets/techninxa-logo.png" alt="Techninxa">
                <p>Innovate. Build. Elevate.</p>
            </div>

            <div class="footer-col">
                <h4>Company</h4>
                <a href="/#about">About</a>
                <a href="/Projects">Projects</a>
                <a href="/#contact">Contact</a>
            </div>

            <div class="footer-col">
                <h4>Services</h4>
                <a href="/#services">Web Development</a>
                <a href="/#services">Mobile Apps</a>
                <a href="/#services">Software</a>
                <a href="/#services">IoT</a>
            </div>

            <div class="footer-col">
                <h4>Connect</h4>
                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=ashik@techninxa.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Mail to CEO
                </a>

                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=labib@techninxa.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Mail To: Labib (Team Member)
                </a>

                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=adittya@techninxa.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Mail To: Adittya (Team Member)
                </a>
            </div>

        </div>

        <div class="container footer-bottom">
            <span>© <span id="year"></span> Techninxa. All rights reserved.</span>
            <span>Designed &amp; built with intention.</span>
        </div>
    </footer>

    <!-- BACK TO TOP + CURSOR -->
    <button class="back-to-top" id="backToTop" type="button" aria-label="Back to top" title="Back to top">
        <span>↑</span>
    </button>

    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>

    <!-- SCRIPTS -->
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>