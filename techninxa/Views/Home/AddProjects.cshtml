@using Techninxa.Models
@model ProjectCreateViewModel
@{
    ViewData["Title"] = "Add Project";
    ViewData["ActiveNav"] = "";
    ViewData["Description"] = "Create and manage Techninxa projects.";
}

<section class="admin-project-page" style="margin-top:80px">

    <div class="admin-project-container">

        <!-- PAGE TOP -->
        <section class="project-page-top">

            <div class="project-page-heading">

                <a href="/dashboard" class="project-back-link">
                    ← Back to Projects
                </a>

                <div class="project-eyebrow">
                    <span></span>
                    Project Management
                </div>

                <h1>
                    Add <em>Project.</em>
                </h1>

                <p>
                    Create a new project and showcase your work
                    with images, videos, technologies and features.
                </p>

            </div>

            <div class="project-page-actions">

                <!-- SAVE DRAFT -->
                <button
                    type="button"
                    class="project-btn project-btn-ghost"
                    id="saveDraftBtn">
                    Save Draft
                </button>

                <!-- PUBLISH -->
                <button
                    type="submit"
                    form="projectForm"
                    class="project-btn project-btn-primary"
                    id="topPublishBtn">
                    Publish Project
                    <span>→</span>
                </button>

            </div>

        </section>
        @if (TempData["ProjectSuccess"] != null)
        {
            <div class="project-success-alert">
                <div class="success-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <div class="success-content">
                    <strong>Success!</strong>
                    <span>@TempData["ProjectSuccess"]</span>
                </div>

                <button type="button"
                        class="success-close"
                        onclick="this.parentElement.remove()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }

        <!-- FORM -->
        <form
            id="projectForm"
            method="post"
            enctype="multipart/form-data"
            asp-action="AddProject"
            asp-controller="Home">

            @Html.AntiForgeryToken()

            <!-- Hidden technology inputs are generated by JavaScript -->
            <div id="technologyInputs"></div>


            <div class="project-admin-layout">


                <!-- =========================
                     MAIN CONTENT
                ========================== -->

                <div class="project-main-content">


                    <!-- BASIC INFORMATION -->

                    <section class="project-admin-card">

                        <div class="project-card-heading">

                            <div class="project-section-number">
                                01
                            </div>

                            <div>
                                <span class="project-kicker">
                                    Project Details
                                </span>

                                <h2>
                                    Basic Information
                                </h2>
                            </div>

                        </div>


                        <div class="project-form-grid">

                            <div class="project-form-group project-full">

                                <label for="projectTitle">
                                    Project Title
                                </label>

                                <input
                                    type="text"
                                    id="projectTitle"
                                    name="Title"
                                    placeholder="Enter project title"
                                    maxlength="100"
                                    required>

                                <span class="project-character-count">
                                    0 / 100
                                </span>

                            </div>


                            <div class="project-form-group">

                                <label for="projectCategory">
                                    Category
                                </label>

                                <select
                                    id="projectCategory"
                                    name="Category"
                                    required>

                                    <option value="">
                                        Select category
                                    </option>

                                    <option value="Web Development">
                                        Web Development
                                    </option>

                                    <option value="Mobile App">
                                        Mobile App
                                    </option>

                                    <option value="IoT">
                                        IoT
                                    </option>

                                    <option value="Software">
                                        Software
                                    </option>

                                    <option value="UI/UX">
                                        UI/UX
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                            </div>


                            <div class="project-form-group">

                                <label for="projectClient">
                                    Client
                                </label>

                                <input
                                    type="text"
                                    id="projectClient"
                                    name="Client"
                                    maxlength="150"
                                    placeholder="Client or company name">

                            </div>


                            <div class="project-form-group">

                                <label for="projectYear">
                                    Project Year
                                </label>

                                <input
                                    type="number"
                                    id="projectYear"
                                    name="Year"
                                    min="2000"
                                    max="2100"
                                    placeholder="2026">

                            </div>


                            <div class="project-form-group">

                                <label for="projectLink">
                                    Live Project URL
                                </label>

                                <input
                                    type="url"
                                    id="projectLink"
                                    name="ProjectUrl"
                                    maxlength="500"
                                    placeholder="https://example.com">

                            </div>


                            <div class="project-form-group project-full">

                                <label for="shortDescription">
                                    Short Description
                                </label>

                                <textarea
                                    id="shortDescription"
                                    name="ShortDescription"
                                    maxlength="300"
                                    placeholder="Write a short description for the project..."></textarea>

                                <span class="project-character-count">
                                    0 / 300
                                </span>

                            </div>

                        </div>

                    </section>


                    <!-- HERO IMAGE -->

                    <section class="project-admin-card">

                        <div class="project-card-title-row">

                            <div>

                                <span class="project-kicker">
                                    Main Visual
                                </span>

                                <h2>
                                    Hero Image
                                </h2>

                            </div>

                            <span class="project-required-badge">
                                REQUIRED
                            </span>

                        </div>


                        <div
                            class="project-hero-upload"
                            id="heroUpload">

                            <input
                                type="file"
                                id="heroInput"
                                name="HeroImage"
                                accept="image/png,image/jpeg,image/webp"
                                hidden
                                required>

                            <div
                                class="project-upload-preview"
                                id="heroPreview">

                                <div class="project-upload-placeholder">

                                    <div class="project-upload-icon">
                                        ↑
                                    </div>

                                    <strong>
                                        Upload hero image
                                    </strong>

                                    <span>
                                        PNG, JPG or WEBP · Maximum 5MB
                                    </span>

                                </div>

                            </div>


                            <label
                                for="heroInput"
                                class="project-upload-button">
                                Choose Image
                            </label>


                            <button
                                type="button"
                                class="project-remove-image"
                                id="removeHero"
                                hidden>
                                Remove
                            </button>

                        </div>

                    </section>


                    <!-- PROJECT MEDIA -->

                    <section class="project-admin-card project-media-card">

                        <div class="project-card-title-row">

                            <div>

                                <span class="project-kicker">
                                    Project Showcase
                                </span>

                                <h2>
                                    Project Media
                                </h2>

                            </div>

                        </div>


                        <p class="project-card-description">
                            Add as many project images and videos as you
                            need. You can select multiple files at once.
                        </p>


                        <!-- IMAGES -->

                        <div class="project-media-section">

                            <div class="project-media-heading">

                                <div>
                                    <h3>
                                        Project Images
                                    </h3>

                                    <span id="imageCount">
                                        0 images
                                    </span>
                                </div>

                                <label
                                    for="imageInput"
                                    class="project-media-add-button">
                                    + Add Images
                                </label>

                            </div>


                            <input
                                type="file"
                                id="imageInput"
                                name="Images"
                                accept="image/png,image/jpeg,image/webp"
                                multiple
                                hidden>


                            <div
                                class="project-media-grid"
                                id="imageGrid">

                                <label
                                    for="imageInput"
                                    class="project-media-add-card">

                                    <div class="project-media-add-icon">
                                        +
                                    </div>

                                    <strong>
                                        Add Images
                                    </strong>

                                    <span>
                                        Select multiple files
                                    </span>

                                </label>

                            </div>

                        </div>


                        <!-- VIDEOS -->

                        <div class="project-media-section project-video-section">

                            <div class="project-media-heading">

                                <div>

                                    <h3>
                                        Project Videos
                                    </h3>

                                    <span id="videoCount">
                                        0 videos
                                    </span>

                                </div>

                                <label
                                    for="videoInput"
                                    class="project-media-add-button">
                                    + Add Videos
                                </label>

                            </div>


                            <input
                                type="file"
                                id="videoInput"
                                name="Videos"
                                accept="video/mp4,video/webm,video/quicktime"
                                multiple
                                hidden>


                            <div
                                class="project-media-grid project-video-grid"
                                id="videoGrid">

                                <label
                                    for="videoInput"
                                    class="project-media-add-card project-video-add-card">

                                    <div class="project-media-add-icon">
                                        +
                                    </div>

                                    <strong>
                                        Add Videos
                                    </strong>

                                    <span>
                                        MP4, WEBM or MOV
                                    </span>

                                </label>

                            </div>

                        </div>


                        <!-- DROPZONE -->

                        <div
                            class="project-media-dropzone"
                            id="mediaDropzone">

                            <div class="project-drop-icon">
                                ↑
                            </div>

                            <div>

                                <strong>
                                    Drop images or videos here
                                </strong>

                                <span>
                                    or click to browse files
                                </span>

                            </div>

                            <small>
                                JPG · PNG · WEBP · MP4 · WEBM · MOV
                            </small>

                        </div>

                    </section>


                    <!-- OVERVIEW -->

                    <section class="project-admin-card">

                        <div class="project-card-title-row">

                            <div>

                                <span class="project-kicker">
                                    Project Story
                                </span>

                                <h2>
                                    Overview
                                </h2>

                            </div>

                        </div>


                        <div class="project-form-group">

                            <label for="projectOverview">
                                Project Overview
                            </label>

                            <textarea
                                id="projectOverview"
                                name="Overview"
                                class="project-large-textarea"
                                placeholder="Describe the project, the problem it solves, the development process and the final result..."></textarea>

                        </div>

                    </section>


                    <!-- TECHNOLOGIES -->

                    <section class="project-admin-card">

                        <div class="project-card-title-row">

                            <div>

                                <span class="project-kicker">
                                    Tech Stack
                                </span>

                                <h2>
                                    Technologies
                                </h2>

                            </div>

                        </div>


                        <div class="project-tag-input-area">

                            <div
                                class="project-selected-tags"
                                id="techTags">
                            </div>

                            <input
                                type="text"
                                id="techInput"
                                placeholder="Type technology and press Enter..."
                                autocomplete="off">

                        </div>


                        <span class="project-field-help">
                            Example: Flutter, Firebase, ESP32, MySQL,
                            JavaScript, .NET
                        </span>

                    </section>


                    <!-- FEATURES -->

                    <section class="project-admin-card">

                        <div class="project-card-title-row">

                            <div>

                                <span class="project-kicker">
                                    Highlights
                                </span>

                                <h2>
                                    Project Features
                                </h2>

                            </div>


                            <button
                                type="button"
                                class="project-small-btn"
                                id="addFeature">
                                + Add Feature
                            </button>

                        </div>


                        <div
                            class="project-feature-editor"
                            id="featureEditor">

                            <div class="project-feature-row">

                                <div class="project-feature-number">
                                    01
                                </div>


                                <div class="project-feature-fields">

                                    <input
                                        type="text"
                                        name="FeatureTitles"
                                        maxlength="150"
                                        placeholder="Feature title">

                                    <textarea
                                        name="FeatureDescriptions"
                                        placeholder="Describe this feature..."></textarea>

                                </div>


                                <button
                                    type="button"
                                    class="project-delete-feature">
                                    ×
                                </button>

                            </div>

                        </div>

                    </section>


                    <!-- NEXT PROJECT -->

                    <section class="project-admin-card">

                        <div class="project-card-title-row">

                            <div>

                                <span class="project-kicker">
                                    Navigation
                                </span>

                                <h2>
                                    Next Project
                                </h2>

                            </div>

                        </div>


                        <div class="project-form-grid">

                            <div class="project-form-group">

                                <label for="nextProject">
                                    Next Project
                                </label>

                                <select
                                    id="nextProject"
                                    name="NextProject">

                                    <option value="">
                                        Select project
                                    </option>

                                </select>

                            </div>


                            <div class="project-form-group">

                                <label for="projectSlug">
                                    Project Slug
                                </label>

                                <input
                                    type="text"
                                    id="projectSlug"
                                    name="Slug"
                                    maxlength="200"
                                    placeholder="smart-water-tank">

                            </div>

                        </div>

                    </section>

                </div>


                <!-- =========================
                     SIDEBAR
                ========================== -->

                <aside class="project-admin-sidebar">


                    <!-- PUBLISH -->

                    <div class="project-side-card project-publish-card">

                        <div class="project-side-card-header">

                            <span class="project-kicker">
                                Publishing
                            </span>

                            <span class="project-status-dot"></span>

                        </div>


                        <div class="project-status-row">

                            <span>
                                Current status
                            </span>

                            <strong id="statusText">
                                Draft
                            </strong>

                        </div>


                        <select
                            class="project-status-select"
                            id="projectStatus"
                            name="Status">

                            <option value="draft">
                                Draft
                            </option>

                            <option value="published">
                                Published
                            </option>

                        </select>


                        <button
                            type="submit"
                            class="project-publish-btn"
                            id="sidebarPublishBtn">

                            <span>
                                Publish Project
                            </span>

                            <span>
                                →
                            </span>

                        </button>

                    </div>


                    <!-- PREVIEW -->

                    <div class="project-side-card">

                        <span class="project-kicker">
                            Preview
                        </span>


                        <div class="project-preview-card">

                            <div class="project-preview-image">

                                <span>
                                    PROJECT PREVIEW
                                </span>

                            </div>


                            <div class="project-preview-info">

                                <span id="previewCategory">
                                    PROJECT
                                </span>

                                <h3 id="previewTitle">
                                    Your Project Title
                                </h3>

                                <p id="previewIntro">
                                    Your project description will
                                    appear here.
                                </p>

                            </div>


                            <a
                                href="#"
                                class="project-preview-link">
                                View Project →
                            </a>

                        </div>

                    </div>


                    <!-- CHECKLIST -->

                    <div class="project-side-card">

                        <h3 class="project-check-title">
                            Publishing Checklist
                        </h3>


                        <div class="project-check-list">

                            <div class="project-check-item">
                                <span>✓</span>
                                <span>Project title</span>
                            </div>

                            <div class="project-check-item">
                                <span>✓</span>
                                <span>Hero image</span>
                            </div>

                            <div class="project-check-item">
                                <span>✓</span>
                                <span>Project overview</span>
                            </div>

                            <div class="project-check-item">
                                <span>✓</span>
                                <span>Technologies</span>
                            </div>

                            <div class="project-check-item">
                                <span>✓</span>
                                <span>Features</span>
                            </div>

                        </div>

                    </div>


                    <!-- TIP -->

                    <div class="project-side-tip">

                        <div class="project-tip-icon">
                            i
                        </div>

                        <div>

                            <strong>
                                Media tip
                            </strong>

                            <p>
                                Use high-quality images and short
                                demonstration videos to make the
                                project page more engaging.
                            </p>

                        </div>

                    </div>

                </aside>

            </div>

        </form>

    </div>

</section>


@section Styles {

<style>

    .admin-project-page {
        padding: 70px 0 100px;
        min-height: 100vh;
    }

    .admin-project-container {
        width: min(1380px, calc(100% - 40px));
        margin: 0 auto;
    }

    .project-page-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 40px;
        margin-bottom: 45px;
    }

    .project-page-heading {
        max-width: 720px;
    }

    .project-back-link {
        display: inline-block;
        color: #667085;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 25px;
        transition: .2s ease;
    }

    .project-back-link:hover {
        color: #1687f8;
    }

    .project-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #1687f8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
        margin-bottom: 13px;
    }

    .project-eyebrow span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #1687f8;
    }

    .project-page-heading h1 {
        margin: 0 0 16px;
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(42px, 5vw, 64px);
        line-height: 1;
        letter-spacing: -2.5px;
        color: #0b1018;
    }

    .project-page-heading h1 em {
        color: #1687f8;
        font-style: normal;
    }

    .project-page-heading p {
        margin: 0;
        max-width: 620px;
        color: #667085;
        font-size: 15px;
        line-height: 1.8;
    }

    .project-page-actions {
        display: flex;
        gap: 12px;
        flex-shrink: 0;
    }

    .project-btn {
        height: 48px;
        padding: 0 20px;
        border-radius: 11px;
        border: 1px solid transparent;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

    .project-btn-ghost {
        background: #fff;
        border-color: #e5e9ef;
        color: #0b1018;
    }

    .project-btn-ghost:hover {
        border-color: #1687f8;
        color: #1687f8;
    }

    .project-btn-primary {
        background: #0b1018;
        color: #fff;
    }

    .project-btn-primary span {
        color: #1687f8;
        margin-left: 8px;
        font-size: 17px;
    }

    .project-btn-primary:hover {
        background: #1687f8;
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(22, 135, 248, .18);
    }

    .project-admin-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 28px;
        align-items: start;
    }

    .project-main-content {
        min-width: 0;
    }

    .project-admin-card,
    .project-side-card {
        background: #fff;
        border: 1px solid #e5e9ef;
        border-radius: 22px;
        box-shadow: 0 15px 45px rgba(11, 16, 24, .055);
    }

    .project-admin-card {
        padding: 32px;
        margin-bottom: 25px;
    }

    .project-card-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
    }

    .project-section-number {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #f0f7ff;
        color: #1687f8;
        font-size: 12px;
        font-weight: 800;
    }

    .project-kicker {
        display: block;
        color: #1687f8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .project-admin-card h2 {
        margin: 0;
        font-family: "Space Grotesk", sans-serif;
        font-size: 23px;
        letter-spacing: -.6px;
        color: #0b1018;
    }

    .project-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .project-full {
        grid-column: 1 / -1;
    }

    .project-form-group {
        position: relative;
    }

    .project-form-group label {
        display: block;
        margin-bottom: 8px;
        color: #0b1018;
        font-size: 12px;
        font-weight: 700;
    }

    .project-form-group input,
    .project-form-group select,
    .project-form-group textarea,
    .project-tag-input-area input {
        width: 100%;
        border: 1px solid #e5e9ef;
        border-radius: 11px;
        background: #f8fafc;
        color: #0b1018;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
        box-sizing: border-box;
    }

    .project-form-group input,
    .project-form-group select {
        height: 50px;
        padding: 0 14px;
    }

    .project-form-group textarea {
        min-height: 125px;
        resize: vertical;
        padding: 14px;
        line-height: 1.6;
    }

    .project-form-group input:focus,
    .project-form-group select:focus,
    .project-form-group textarea:focus,
    .project-tag-input-area input:focus {
        border-color: #1687f8;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(22, 135, 248, .07);
    }

    .project-character-count {
        position: absolute;
        right: 12px;
        bottom: 10px;
        color: #98a2b3;
        font-size: 10px;
    }

    .project-card-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .project-required-badge {
        padding: 6px 9px;
        border-radius: 6px;
        background: #fef3f2;
        color: #b42318;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .project-hero-upload {
        text-align: center;
    }

    .project-upload-preview {
        min-height: 270px;
        border: 1px dashed #d0d5dd;
        border-radius: 16px;
        background: #f8fafc;
        display: grid;
        place-items: center;
        overflow: hidden;
        margin-bottom: 15px;
    }

    .project-upload-preview img {
        width: 100%;
        height: 100%;
        min-height: 270px;
        object-fit: cover;
    }

    .project-upload-placeholder {
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: 8px;
        color: #667085;
    }

    .project-upload-placeholder strong {
        color: #0b1018;
        font-size: 14px;
    }

    .project-upload-placeholder span {
        font-size: 11px;
    }

    .project-upload-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #eaf4ff;
        color: #1687f8;
        font-size: 23px;
        margin-bottom: 5px;
    }

    .project-upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 43px;
        padding: 0 18px;
        border-radius: 10px;
        background: #0b1018;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .project-remove-image {
        margin-left: 8px;
        height: 43px;
        padding: 0 15px;
        border: 1px solid #e5e9ef;
