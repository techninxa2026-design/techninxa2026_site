@section Scripts {

<script>

    /* =========================================================
       HERO IMAGE
    ========================================================= */

    const heroInput = document.getElementById("heroInput");
    const heroPreview = document.getElementById("heroPreview");
    const removeHero = document.getElementById("removeHero");

    heroInput.addEventListener("change", function () {

        const file = this.files[0];

        if (!file) {
            return;
        }

        if (!file.type.startsWith("image/")) {
            alert("Please select a valid image.");
            this.value = "";
            return;
        }

        const url = URL.createObjectURL(file);

        heroPreview.innerHTML = `
            <img src="${url}" alt="Hero preview">
        `;

        removeHero.hidden = false;

    });


    removeHero.addEventListener("click", function () {

        heroInput.value = "";

        heroPreview.innerHTML = `
            <div class="project-upload-placeholder">

                <div class="project-upload-icon">
                    ↑
                </div>

                <strong>
                    Upload hero image
                </strong>

                <span>
                    PNG, JPG or WEBP · Maximum 5MB
                </span>

            </div>
        `;

        removeHero.hidden = true;

    });


    /* =========================================================
       PROJECT IMAGES
       DataTransfer keeps all selected files attached to input.
    ========================================================= */

    const imageInput = document.getElementById("imageInput");
    const imageGrid = document.getElementById("imageGrid");
    const imageCount = document.getElementById("imageCount");

    let selectedImages = [];
    let imageDataTransfer = new DataTransfer();


    imageInput.addEventListener("change", function () {

        const files = Array.from(this.files);

        files.forEach(function (file) {

            if (!file.type.startsWith("image/")) {
                return;
            }

            const alreadyExists = selectedImages.some(function (existingFile) {

                return existingFile.name === file.name &&
                       existingFile.size === file.size &&
                       existingFile.lastModified === file.lastModified;

            });

            if (!alreadyExists) {
                selectedImages.push(file);
                imageDataTransfer.items.add(file);
            }

        });

        imageInput.files = imageDataTransfer.files;

        renderImages();

    });


    function renderImages() {

        imageGrid.innerHTML = "";

        selectedImages.forEach(function (file, index) {

            const url = URL.createObjectURL(file);

            const card = document.createElement("div");

            card.className = "project-media-preview-card";

            card.innerHTML = `
                <img src="${url}" alt="Project image ${index + 1}">

                <div class="project-media-overlay">

                    <span>
                        ${index + 1}
                    </span>

                    <button
                        type="button"
                        class="project-media-remove"
                        data-index="${index}">
                        ×
                    </button>

                </div>
            `;

            imageGrid.appendChild(card);

        });


        const addCard = document.createElement("label");

        addCard.className = "project-media-add-card";
        addCard.setAttribute("for", "imageInput");

        addCard.innerHTML = `
            <div class="project-media-add-icon">
                +
            </div>

            <strong>
                Add Images
            </strong>

            <span>
                Select multiple files
            </span>
        `;

        imageGrid.appendChild(addCard);


        imageCount.textContent =
            `${selectedImages.length} ${
                selectedImages.length === 1
                    ? "image"
                    : "images"
            }`;


        imageGrid
            .querySelectorAll(".project-media-remove")
            .forEach(function (button) {

                button.addEventListener("click", function () {

                    const index =
                        Number(this.dataset.index);

                    selectedImages.splice(index, 1);

                    rebuildImageDataTransfer();

                    renderImages();

                });

            });

    }


    function rebuildImageDataTransfer() {

        imageDataTransfer = new DataTransfer();

        selectedImages.forEach(function (file) {
            imageDataTransfer.items.add(file);
        });

        imageInput.files =
            imageDataTransfer.files;

    }


    /* =========================================================
       PROJECT VIDEOS
    ========================================================= */

    const videoInput =
        document.getElementById("videoInput");

    const videoGrid =
        document.getElementById("videoGrid");

    const videoCount =
        document.getElementById("videoCount");

    let selectedVideos = [];
    let videoDataTransfer = new DataTransfer();


    videoInput.addEventListener("change", function () {

        const files = Array.from(this.files);

        files.forEach(function (file) {

            if (!file.type.startsWith("video/")) {
                return;
            }

            const alreadyExists = selectedVideos.some(function (existingFile) {

                return existingFile.name === file.name &&
                       existingFile.size === file.size &&
                       existingFile.lastModified === file.lastModified;

            });

            if (!alreadyExists) {

                selectedVideos.push(file);

                videoDataTransfer.items.add(file);

            }

        });

        videoInput.files =
            videoDataTransfer.files;

        renderVideos();

    });


    function renderVideos() {

        videoGrid.innerHTML = "";

        selectedVideos.forEach(function (file, index) {

            const url = URL.createObjectURL(file);

            const card =
                document.createElement("div");

            card.className =
                "project-media-preview-card";

            card.innerHTML = `
                <video
                    src="${url}"
                    muted
                    preload="metadata">
                </video>

                <div class="project-video-play">
                    ▶
                </div>

                <div class="project-media-overlay">

                    <span>
                        ${index + 1}
                    </span>

                    <button
                        type="button"
                        class="project-media-remove"
                        data-index="${index}">
                        ×
                    </button>

                </div>
            `;

            videoGrid.appendChild(card);

        });


        const addCard =
            document.createElement("label");

        addCard.className =
            "project-media-add-card";

        addCard.setAttribute(
            "for",
            "videoInput"
        );

        addCard.innerHTML = `
            <div class="project-media-add-icon">
                +
            </div>

            <strong>
                Add Videos
            </strong>

            <span>
                MP4, WEBM or MOV
            </span>
        `;

        videoGrid.appendChild(addCard);


        videoCount.textContent =
            `${selectedVideos.length} ${
                selectedVideos.length === 1
                    ? "video"
                    : "videos"
            }`;


        videoGrid
            .querySelectorAll(".project-media-remove")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const index =
                            Number(this.dataset.index);

                        selectedVideos.splice(index, 1);

                        rebuildVideoDataTransfer();

                        renderVideos();

                    }
                );

            });

    }


    function rebuildVideoDataTransfer() {

        videoDataTransfer =
            new DataTransfer();

        selectedVideos.forEach(function (file) {

            videoDataTransfer.items.add(file);

        });

        videoInput.files =
            videoDataTransfer.files;

    }


    /* =========================================================
       TECHNOLOGIES
    ========================================================= */

    const techInput =
        document.getElementById("techInput");

    const techTags =
        document.getElementById("techTags");

    const technologyInputs =
        document.getElementById("technologyInputs");

    let technologies = [];


    techInput.addEventListener(
        "keydown",
        function (event) {

            if (event.key !== "Enter") {
                return;
            }

            event.preventDefault();

            const value =
                this.value.trim();

            if (
                value &&
                !technologies.some(function (technology) {

                    return technology.toLowerCase() ===
                           value.toLowerCase();

                })
            ) {

                technologies.push(value);

                renderTechnologies();

            }

            this.value = "";

        }
    );


    function renderTechnologies() {

        techTags.innerHTML = "";

        technologyInputs.innerHTML = "";


        technologies.forEach(function (
            technology,
            index
        ) {

            /* Visible tag */

            const tag =
                document.createElement("div");

            tag.className =
                "project-tag";

            tag.innerHTML = `
                <span>
                    ${escapeHtml(technology)}
                </span>

                <button
                    type="button"
                    data-index="${index}">
                    ×
                </button>
            `;

            techTags.appendChild(tag);


            /* Hidden form input */

            const hiddenInput =
                document.createElement("input");

            hiddenInput.type = "hidden";
            hiddenInput.name = "Technologies";
            hiddenInput.value = technology;

            technologyInputs.appendChild(hiddenInput);

        });


        techTags
            .querySelectorAll("button")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        technologies.splice(
                            Number(this.dataset.index),
                            1
                        );

                        renderTechnologies();

                    }
                );

            });

    }


    function escapeHtml(value) {

        const div =
            document.createElement("div");

        div.textContent = value;

        return div.innerHTML;

    }


    /* =========================================================
       FEATURES
    ========================================================= */

    const featureEditor =
        document.getElementById("featureEditor");

    const addFeature =
        document.getElementById("addFeature");


    addFeature.addEventListener(
        "click",
        function () {

            const row =
                document.createElement("div");

            row.className =
                "project-feature-row";

            row.innerHTML = `

                <div class="project-feature-number">
                    01
                </div>

                <div class="project-feature-fields">

                    <input
                        type="text"
                        name="FeatureTitles"
                        maxlength="150"
                        placeholder="Feature title">

                    <textarea
                        name="FeatureDescriptions"
                        placeholder="Describe this feature..."></textarea>

                </div>

                <button
                    type="button"
                    class="project-delete-feature">
                    ×
                </button>

            `;

            featureEditor.appendChild(row);

            updateFeatureNumbers();

        }
    );


    featureEditor.addEventListener(
        "click",
        function (event) {

            if (
                event.target.classList.contains(
                    "project-delete-feature"
                )
            ) {

                if (
                    featureEditor.children.length <= 1
                ) {
                    return;
                }

                event.target
                    .closest(".project-feature-row")
                    .remove();

                updateFeatureNumbers();

            }

        }
    );


    function updateFeatureNumbers() {

        Array.from(
            featureEditor.children
        ).forEach(function (row, index) {

            row.querySelector(
                ".project-feature-number"
            ).textContent =
                String(index + 1).padStart(2, "0");

        });

    }


    /* =========================================================
       LIVE PREVIEW
    ========================================================= */

    const projectTitle =
        document.getElementById("projectTitle");

    const projectCategory =
        document.getElementById("projectCategory");

    const shortDescription =
        document.getElementById("shortDescription");

    const previewTitle =
        document.getElementById("previewTitle");

    const previewCategory =
        document.getElementById("previewCategory");

    const previewIntro =
        document.getElementById("previewIntro");


    projectTitle.addEventListener(
        "input",
        function () {

            previewTitle.textContent =
                this.value ||
                "Your Project Title";

        }
    );


    projectCategory.addEventListener(
        "change",
        function () {

            previewCategory.textContent =
                this.value ||
                "PROJECT";

        }
    );


    shortDescription.addEventListener(
        "input",
        function () {

            previewIntro.textContent =
                this.value ||
                "Your project description will appear here.";

        }
    );


    /* =========================================================
       CHARACTER COUNTERS
    ========================================================= */

    document
        .querySelectorAll(
            'input[maxlength], textarea[maxlength]'
        )
        .forEach(function (field) {

            const counter =
                field.parentElement.querySelector(
                    ".project-character-count"
                );

            if (!counter) {
                return;
            }


            function updateCounter() {

                counter.textContent =
                    `${field.value.length} / ${field.maxLength}`;

            }


            field.addEventListener(
                "input",
                updateCounter
            );

            updateCounter();

        });


    /* =========================================================
       STATUS
    ========================================================= */

    const projectStatus =
        document.getElementById("projectStatus");

    const statusText =
        document.getElementById("statusText");


    projectStatus.addEventListener(
        "change",
        function () {

            statusText.textContent =
                this.value === "published"
                    ? "Published"
                    : "Draft";

        }
    );


    /* =========================================================
       SAVE DRAFT
    ========================================================= */

    const saveDraftBtn =
        document.getElementById("saveDraftBtn");


    saveDraftBtn.addEventListener(
        "click",
        function () {

            projectStatus.value = "draft";

            statusText.textContent = "Draft";

            document
                .getElementById("projectForm")
                .requestSubmit();

        }
    );


    /* =========================================================
       PUBLISH BUTTONS
    ========================================================= */

    const topPublishBtn =
        document.getElementById("topPublishBtn");

    const sidebarPublishBtn =
        document.getElementById("sidebarPublishBtn");


    topPublishBtn.addEventListener(
        "click",
        function () {

            projectStatus.value = "published";

        }
    );


    sidebarPublishBtn.addEventListener(
        "click",
        function () {

            projectStatus.value = "published";

        }
    );


    /* =========================================================
       DROPZONE
    ========================================================= */

    const dropzone =
        document.getElementById("mediaDropzone");


    [
        "dragenter",
        "dragover"
    ].forEach(function (eventName) {

        dropzone.addEventListener(
            eventName,
            function (event) {

                event.preventDefault();
                event.stopPropagation();

                dropzone.classList.add(
                    "drag-active"
                );

            }
        );

    });


    [
        "dragleave",
        "drop"
    ].forEach(function (eventName) {

        dropzone.addEventListener(
            eventName,
            function (event) {

                event.preventDefault();
                event.stopPropagation();

                dropzone.classList.remove(
                    "drag-active"
                );

            }
        );

    });


    dropzone.addEventListener(
        "drop",
        function (event) {

            const files =
                Array.from(
                    event.dataTransfer.files
                );


            files.forEach(function (file) {

                if (
                    file.type.startsWith("image/")
                ) {

                    const exists =
                        selectedImages.some(
                            function (existingFile) {

                                return existingFile.name === file.name &&
                                       existingFile.size === file.size &&
                                       existingFile.lastModified === file.lastModified;

                            }
                        );

                    if (!exists) {

                        selectedImages.push(file);

                    }

                }
                else if (
                    file.type.startsWith("video/")
                ) {

                    const exists =
                        selectedVideos.some(
                            function (existingFile) {

                                return existingFile.name === file.name &&
                                       existingFile.size === file.size &&
                                       existingFile.lastModified === file.lastModified;

                            }
                        );

                    if (!exists) {

                        selectedVideos.push(file);

                    }

                }

            });


            rebuildImageDataTransfer();
            rebuildVideoDataTransfer();

            renderImages();
            renderVideos();

        }
    );


    /* =========================================================
       CLICK DROPZONE TO BROWSE
    ========================================================= */

    dropzone.addEventListener(
        "click",
        function () {

            const choice =
                confirm(
                    "Click OK to select images.\n\n" +
                    "Click Cancel to select videos."
                );

            if (choice) {

                imageInput.click();

            }
            else {

                videoInput.click();

            }

        }
    );


    /* =========================================================
       INITIAL STATE
    ========================================================= */

    updateFeatureNumbers();
    renderTechnologies();
    renderImages();
    renderVideos();

</script>

}

