@model List<techninxa.Models.Meeting>

@{
    var unreadCount = Model?.Count ?? 0;
}

<div class="dashboard" style="margin-top: 80px;">

    <aside class="dashboard-sidebar">

        <div class="dashboard-sidebar-logo" style="margin-top: 100px">
            <img src="~/assets/techninxa-logo.png" alt="Techninxa">
        </div>

        <nav class="dashboard-nav">

            <a href="/InsertProject" class="dashboard-nav-link">
                <span>＋</span>
                <span>Add Project</span>
            </a>

            <a href="/setholydays" class="dashboard-nav-link" style="margin-top: 50px">
                <span>Set Holidays</span>
            </a>
             <a href="/Team" class="dashboard-nav-link" style="margin-top: 50px">
                <span>Teams</span>
            </a>
            <a href="/timeslots" class="dashboard-nav-link" style="margin-top: 50px">
                <span>Time Slots</span>
            </a>

            <a href="/meetingstojoin" class="dashboard-nav-link" style="margin-top: 50px">
                <span>Meetings to Join</span>
            </a>
            <a href="/clientsmesseges" class="dashboard-nav-link" style="margin-top: 50px">
                <span>Client Messeges</span>
            </a>

        </nav>

    </aside>


    <section class="dashboard-content">

        <!-- TOP BAR -->

        <div class="dashboard-topbar">

            <div>
                <h1>Dashboard</h1>
                <p>Manage your Techninxa workspace.</p>
            </div>


            <button type="button"
                    class="notification-button"
                    id="notificationButton">

                <span class="notification-icon">🔔</span>

                @if (unreadCount > 0)
                {
                    <span class="notification-badge">
                        @unreadCount
                    </span>
                }

            </button>

        </div>


        <!-- NOTIFICATION PANEL -->

        <div class="notification-panel" id="notificationPanel">

            <div class="notification-panel-header">

                <div>
                    <h3>Meetings</h3>
                    <p>New meeting requests</p>
                </div>

                <button type="button"
                        class="notification-close"
                        id="notificationClose">
                    ×
                </button>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="meeting-notification-list">

                    @foreach (var meeting in Model)
                    {
                        <div class="meeting-notification">

                            <div class="meeting-notification-avatar">
                                @(string.IsNullOrWhiteSpace(meeting.Name)
                                    ? "?"
                                    : meeting.Name.Substring(0, 1).ToUpper())
                            </div>


                            <div class="meeting-notification-content">

                                <div class="meeting-notification-name">
                                    @meeting.Name
                                </div>

                                <div class="meeting-notification-email">
                                    @meeting.Email
                                </div>

                                <div class="meeting-notification-date">

                                    @meeting.MeetingDate.ToString("ddd, MMM d, yyyy")
                                    ·
                                    @DateTime.Today.Add(meeting.StartTime).ToString("h:mm tt")

                                </div>


                                <a href="/meetingstojoin"
                                   class="meeting-view-button">

                                    View Meeting

                                </a>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="no-meetings">

                    <div class="no-meetings-icon">
                        ✓
                    </div>

                    <h4>No new meetings</h4>

                    <p>
                        You don't have any new meeting requests.
                    </p>

                </div>
            }

        </div>


        <div class="dashboard-content-area">

            @* Dashboard content will be added later *@

        </div>

    </section>

</div>


<style>

    .dashboard {
        min-height: calc(100vh - 90px);
        display: flex;
        background: white;
        color: #0f172a;
    }


    /* SIDEBAR */

    .dashboard-sidebar {
        width: 240px;
        min-height: calc(100vh - 90px);
        padding: 28px 16px;
        background: white;
        border-right: 1px solid #e2e8f0;
    }


    .dashboard-sidebar-logo {
        padding: 0 12px 25px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
    }


    .dashboard-sidebar-logo img {
        width: 135px;
        display: block;
    }


    .dashboard-nav {
        display: flex;
        flex-direction: column;
    }


    .dashboard-nav-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 14px;
        background: #1687f8;
        border-radius: 9px;
        color: white;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: .2s ease;
    }


    .dashboard-nav-link span:first-child {
        font-size: 20px;
        color: white;
    }


    .dashboard-nav-link:hover,
    .dashboard-nav-link.active {
        color: white;
        background: #0875df;
    }


    /* CONTENT */

    .dashboard-content {
        flex: 1;
        padding: 40px;
        position: relative;
    }


    .dashboard-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 35px;
    }


    .dashboard-topbar h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 750;
        color: #0f172a;
    }


    .dashboard-topbar p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }


    /* NOTIFICATION BUTTON */

    .notification-button {
        position: relative;
        width: 48px;
        height: 48px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .06);
        transition: .2s ease;
    }


    .notification-button:hover {
        transform: translateY(-2px);
        border-color: #93c5fd;
        box-shadow: 0 8px 25px rgba(22, 135, 248, .12);
    }


    .notification-icon {
        font-size: 21px;
    }


    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 21px;
        height: 21px;
        padding: 0 5px;
        border-radius: 20px;
        background: #ef4444;
        color: white;
        border: 2px solid white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
    }


    /* NOTIFICATION PANEL */

    .notification-panel {
        position: absolute;
        z-index: 100;
        top: 95px;
        right: 40px;
        width: 390px;
        max-height: 570px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .16);
        overflow: hidden;

        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: .2s ease;
    }


    .notification-panel.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }


    .notification-panel-header {
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e2e8f0;
    }


    .notification-panel-header h3 {
        margin: 0;
        font-size: 17px;
        color: #0f172a;
    }


    .notification-panel-header p {
        margin: 4px 0 0;
        color: #94a3b8;
        font-size: 12px;
    }


    .notification-close {
        width: 30px;
        height: 30px;
        border: none;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 20px;
        color: #64748b;
        cursor: pointer;
    }


    .notification-close:hover {
        background: #e2e8f0;
    }


    /* MEETING LIST */

    .meeting-notification-list {
        max-height: 480px;
        overflow-y: auto;
    }


    .meeting-notification {
        display: flex;
        gap: 13px;
        padding: 17px 20px;
        border-bottom: 1px solid #f1f5f9;
        transition: .2s ease;
    }


    .meeting-notification:hover {
        background: #f8fafc;
    }


    .meeting-notification-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, #1687f8, #38bdf8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }


    .meeting-notification-content {
        min-width: 0;
        flex: 1;
    }


    .meeting-notification-name {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
    }


    .meeting-notification-email {
        margin-top: 2px;
        font-size: 11px;
        color: #64748b;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .meeting-notification-date {
        margin-top: 7px;
        font-size: 11px;
        color: #1687f8;
        font-weight: 600;
    }


    .meeting-view-button {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 11px;
        border-radius: 8px;
        background: #eff6ff;
        color: #1687f8;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
    }


    .meeting-view-button:hover {
        background: #dbeafe;
    }


    /* EMPTY */

    .no-meetings {
        padding: 50px 25px;
        text-align: center;
    }


    .no-meetings-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 12px;
        border-radius: 15px;
        background: #ecfdf5;
        color: #10b981;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
    }


    .no-meetings h4 {
        margin: 0 0 5px;
        color: #0f172a;
    }


    .no-meetings p {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
    }


    .dashboard-content-area {
        min-height: 400px;
    }


    @@media (max-width: 700px) {

        .dashboard-sidebar {
            width: 200px;
        }

        .dashboard-content {
            padding: 25px;
        }

        .notification-panel {
            right: 20px;
            width: calc(100vw - 40px);
        }

    }

</style>


<script>

    const notificationButton =
        document.getElementById("notificationButton");

    const notificationPanel =
        document.getElementById("notificationPanel");

    const notificationClose =
        document.getElementById("notificationClose");


    notificationButton.addEventListener("click", function () {

        notificationPanel.classList.toggle("show");

    });


    notificationClose.addEventListener("click", function () {

        notificationPanel.classList.remove("show");

    });


    document.addEventListener("click", function (event) {

        if (
            !notificationPanel.contains(event.target) &&
            !notificationButton.contains(event.target)
        ) {

            notificationPanel.classList.remove("show");

        }

    });

</script>