    <!-- ======================================================
         INCOMING CALL
         ====================================================== -->

    <div
        class="incoming-call"
        id="incomingCall">

        <div class="incoming-title">
            Incoming call
        </div>

        <div
            class="incoming-text"
            id="incomingCallText">
            Someone is calling you...
        </div>

        <div class="incoming-actions">

            <button
                type="button"
                class="accept-call"
                id="acceptCallButton">
                Accept
            </button>

            <button
                type="button"
                class="reject-call"
                id="rejectCallButton">
                Reject
            </button>

        </div>

    </div>


    <!-- ======================================================
         SIGNALR
         ====================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>


    <script>

        /* =====================================================
           CURRENT USER
           ===================================================== */

        const currentUsername =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(username)
            );


        /* =====================================================
           DOM ELEMENTS
           ===================================================== */

        const messagesArea =
            document.getElementById("messagesArea");

        const messageInput =
            document.getElementById("messageInput");

        const sendButton =
            document.getElementById("sendButton");

        const emptyChat =
            document.getElementById("emptyChat");

        const onlineUsersContainer =
            document.getElementById("onlineUsers");

        const onlineCount =
            document.getElementById("onlineCount");

        const userSearch =
            document.getElementById("userSearch");

        const connectionStatus =
            document.getElementById("connectionStatus");

        const chatSidebar =
            document.getElementById("chatSidebar");

        const mobileMenuButton =
            document.getElementById("mobileMenuButton");

        const emojiButton =
            document.getElementById("emojiButton");

        const emojiPicker =
            document.getElementById("emojiPicker");

        const attachFileButton =
            document.getElementById("attachFileButton");

        const chatFileInput =
            document.getElementById("chatFileInput");

        const uploadingIndicator =
            document.getElementById("uploadingIndicator");

        const voiceCallButton =
            document.getElementById("voiceCallButton");

        const videoCallButton =
            document.getElementById("videoCallButton");

        const callOverlay =
            document.getElementById("callOverlay");

        const callPerson =
            document.getElementById("callPerson");

        const callType =
            document.getElementById("callType");

        const callAvatar =
            document.getElementById("callAvatar");

        const voiceName =
            document.getElementById("voiceName");

        const voiceStatus =
            document.getElementById("voiceStatus");

        const voicePlaceholder =
            document.getElementById("voicePlaceholder");

        const remoteVideo =
            document.getElementById("remoteVideo");

        const localVideo =
            document.getElementById("localVideo");

        const muteButton =
            document.getElementById("muteButton");

        const cameraButton =
            document.getElementById("cameraButton");

        const endCallButton =
            document.getElementById("endCallButton");

        const callCloseButton =
            document.getElementById("callCloseButton");

        const incomingCall =
            document.getElementById("incomingCall");

        const incomingCallText =
            document.getElementById("incomingCallText");

        const acceptCallButton =
            document.getElementById("acceptCallButton");

        const rejectCallButton =
            document.getElementById("rejectCallButton");


        /* =====================================================
           STATE
           ===================================================== */

        const displayedMessageIds =
            new Set();

        let onlineUsers = [];

        let isSending = false;

        let localStream = null;

        let peerConnection = null;

        let currentCallUser = null;

        let currentCallType = null;

        let incomingCallData = null;

        let isMuted = false;

        let isCameraOff = false;

        let pendingIceCandidates = [];


        /* =====================================================
           SIGNALR CONNECTION
           ===================================================== */

        const connection =
            new signalR.HubConnectionBuilder()
                .withUrl("/companyChatHub")
                .withAutomaticReconnect([
                    0,
                    2000,
                    5000,
                    10000,
                    15000
                ])
                .configureLogging(
                    signalR.LogLevel.Warning
                )
                .build();


        /* =====================================================
           SIGNALR - RECEIVE MESSAGE
           ===================================================== */

        connection.on(
            "ReceiveMessage",
            function (
                id,
                username,
                message,
                time
            ) {

                addMessage(
                    id,
                    username,
                    message,
                    time
                );

            }
        );


        /* =====================================================
           SIGNALR - ONLINE USERS
           ===================================================== */

        connection.on(
            "OnlineUsers",
            function (users) {

                onlineUsers =
                    Array.isArray(users)
                        ? users
                        : [];

                renderOnlineUsers(
                    onlineUsers
                );

            }
        );


        connection.on(
            "UserOnline",
            function (username) {

                if (
                    !onlineUsers.some(
                        x =>
                            x.toLowerCase() ===
                            username.toLowerCase()
                    )
                ) {

                    onlineUsers.push(username);

                }

                renderOnlineUsers(
                    onlineUsers
                );

            }
        );


        connection.on(
            "UserOffline",
            function (username) {

                onlineUsers =
                    onlineUsers.filter(
                        x =>
                            x.toLowerCase() !==
                            username.toLowerCase()
                    );

                renderOnlineUsers(
                    onlineUsers
                );

            }
        );


        /* =====================================================
           SIGNALR - CALL EVENTS
           ===================================================== */

        connection.on(
            "IncomingCall",
            function (
                caller,
                callType,
                offer
            ) {

                incomingCallData = {
                    caller: caller,
                    callType: callType,
                    offer: offer
                };

                incomingCallText.textContent =
                    caller +
                    " is calling you (" +
                    callType +
                    ").";

                incomingCall.classList.add(
                    "show"
                );

            }
        );


        connection.on(
            "CallAccepted",
            async function (answer) {

                if (!peerConnection) {
                    return;
                }

                await peerConnection.setRemoteDescription(
                    new RTCSessionDescription(answer)
                );

                voiceStatus.textContent =
                    "Connected";

                await processPendingIceCandidates();

            }
        );


        connection.on(
            "CallRejected",
            function () {

                voiceStatus.textContent =
                    "Call rejected.";

                setTimeout(
                    closeCall,
                    1200
                );

            }
        );


        connection.on(
            "CallEnded",
            function () {

                closeCall();

            }
        );


        connection.on(
            "IceCandidate",
            async function (candidate) {

                if (!peerConnection) {
                    return;
                }

                try {

                    if (
                        peerConnection.remoteDescription
                    ) {

                        await peerConnection.addIceCandidate(
                            new RTCIceCandidate(candidate)
                        );

                    }
                    else {

                        pendingIceCandidates.push(
                            candidate
                        );

                    }

                }
                catch (error) {

                    console.error(
                        "ICE candidate error:",
                        error
                    );

                }

            }
        );


        /* =====================================================
           PEER CONNECTION
           ===================================================== */

        function createPeerConnection() {

            const config = {

                iceServers: [

                    {
                        urls:
                            "stun:stun.l.google.com:19302"
                    }

                ]

            };

            peerConnection =
                new RTCPeerConnection(config);


            peerConnection.onicecandidate =
                async function (event) {

                    if (
                        event.candidate &&
                        currentCallUser
                    ) {

                        try {

                            await connection.invoke(
                                "SendIceCandidate",
                                currentCallUser,
                                event.candidate
                            );

                        }
                        catch (error) {

                            console.error(
                                "Send ICE error:",
                                error
                            );

                        }

                    }

                };


            peerConnection.ontrack =
                function (event) {

                    if (
                        event.streams &&
                        event.streams[0]
                    ) {

                        remoteVideo.srcObject =
                            event.streams[0];

                    }

                };


            peerConnection.onconnectionstatechange =
                function () {

                    if (!peerConnection) {
                        return;
                    }

                    const state =
                        peerConnection.connectionState;

                    console.log(
                        "WebRTC state:",
                        state
                    );

                    if (state === "connected") {

                        voiceStatus.textContent =
                            "Connected";

                    }

                    if (
                        state === "disconnected" ||
                        state === "failed" ||
                        state === "closed"
                    ) {

                        voiceStatus.textContent =
                            "Connection ended.";

                    }

                };


            return peerConnection;
        }


        /* =====================================================
           START VOICE CALL
           ===================================================== */

        async function startVoiceCall(
            targetUser
        ) {

            if (!targetUser) {

                alert(
                    "Select an online user first."
                );

                return;

            }

            if (
                targetUser.toLowerCase() ===
                currentUsername.toLowerCase()
            ) {

                alert(
                    "You cannot call yourself."
                );

                return;

            }

            try {

                currentCallUser =
                    targetUser;

                currentCallType =
                    "voice";

                openCallWindow(
                    targetUser,
                    "Voice call"
                );

                voiceStatus.textContent =
                    "Requesting microphone...";


                localStream =
                    await navigator.mediaDevices.getUserMedia(
                        {
                            audio: true,
                            video: false
                        }
                    );


                createPeerConnection();


                localStream
                    .getTracks()
                    .forEach(
                        track =>
                            peerConnection.addTrack(
                                track,
                                localStream
                            )
                    );


                const offer =
                    await peerConnection.createOffer();

                await peerConnection.setLocalDescription(
                    offer
                );


                await connection.invoke(
                    "CallUser",
                    targetUser,
                    "voice",
                    offer
                );


                voiceStatus.textContent =
                    "Calling " +
                    targetUser +
                    "...";

            }
            catch (error) {

                console.error(
                    "Voice call error:",
                    error
                );

                alert(
                    "Unable to start voice call. Please allow microphone access."
                );

                closeCall();

            }

        }


        /* =====================================================
           START VIDEO CALL
           ===================================================== */

        async function startVideoCall(
            targetUser
        ) {

            if (!targetUser) {

                alert(
                    "Select an online user first."
                );

                return;

            }

            if (
                targetUser.toLowerCase() ===
                currentUsername.toLowerCase()
            ) {

                alert(
                    "You cannot call yourself."
                );

                return;

            }

            try {

                currentCallUser =
                    targetUser;

                currentCallType =
                    "video";

                openCallWindow(
                    targetUser,
                    "Video call"
                );

                voiceStatus.textContent =
                    "Requesting camera and microphone...";


                localStream =
                    await navigator.mediaDevices.getUserMedia(
                        {
                            audio: true,
                            video: true
                        }
                    );


                localVideo.srcObject =
                    localStream;

                localVideo.style.display =
                    "block";


                remoteVideo.style.display =
                    "block";

                voicePlaceholder.style.display =
                    "none";

                cameraButton.style.display =
                    "flex";


                createPeerConnection();


                localStream
                    .getTracks()
                    .forEach(
                        track =>
                            peerConnection.addTrack(
                                track,
                                localStream
                            )
                    );


                const offer =
                    await peerConnection.createOffer();

                await peerConnection.setLocalDescription(
                    offer
                );


                await connection.invoke(
                    "CallUser",
                    targetUser,
                    "video",
                    offer
                );


                voiceStatus.textContent =
                    "Calling " +
                    targetUser +
                    "...";

            }
            catch (error) {

                console.error(
                    "Video call error:",
                    error
                );

                alert(
                    "Unable to start video call. Please allow camera and microphone access."
                );

                closeCall();

            }

        }


        /* =====================================================
           ACCEPT CALL
           ===================================================== */

        acceptCallButton.addEventListener(
            "click",
            async function () {

                if (!incomingCallData) {
                    return;
                }

                const data =
                    incomingCallData;

                incomingCall.classList.remove(
                    "show"
                );

                try {

                    currentCallUser =
                        data.caller;

                    currentCallType =
                        data.callType;

                    openCallWindow(
                        data.caller,
                        data.callType === "video"
                            ? "Video call"
                            : "Voice call"
                    );


                    const wantsVideo =
                        data.callType === "video";


                    localStream =
                        await navigator.mediaDevices.getUserMedia(
                            {
                                audio: true,
                                video: wantsVideo
                            }
                        );


                    if (wantsVideo) {

                        localVideo.srcObject =
                            localStream;

                        localVideo.style.display =
                            "block";

                        remoteVideo.style.display =
                            "block";

                        voicePlaceholder.style.display =
                            "none";

                        cameraButton.style.display =
                            "flex";

                    }


                    createPeerConnection();


                    localStream
                        .getTracks()
                        .forEach(
                            track =>
                                peerConnection.addTrack(
                                    track,
                                    localStream
                                )
                        );


                    await peerConnection.setRemoteDescription(
                        new RTCSessionDescription(
                            data.offer
                        )
                    );


                    await processPendingIceCandidates();


                    const answer =
                        await peerConnection.createAnswer();


                    await peerConnection.setLocalDescription(
                        answer
                    );


                    await connection.invoke(
                        "AcceptCall",
                        data.caller,
                        answer
                    );


                    voiceStatus.textContent =
                        "Connected";

                }
                catch (error) {

                    console.error(
                        "Accept call error:",
                        error
                    );

                    closeCall();

                }

                incomingCallData =
                    null;

            }
        );


        /* =====================================================
           REJECT CALL
           ===================================================== */

        rejectCallButton.addEventListener(
            "click",
            async function () {

                if (!incomingCallData) {
                    return;
                }

                try {

                    await connection.invoke(
                        "RejectCall",
                        incomingCallData.caller
                    );

                }
                catch (error) {

                    console.error(
                        error
                    );

                }

                incomingCallData =
                    null;

                incomingCall.classList.remove(
                    "show"
                );

            }
        );


        /* =====================================================
           ICE CANDIDATES
           ===================================================== */

        async function processPendingIceCandidates() {

            if (!peerConnection) {
                return;
            }

            for (
                const candidate
                of pendingIceCandidates
            ) {

                try {

                    await peerConnection.addIceCandidate(
                        new RTCIceCandidate(candidate)
                    );

                }
                catch (error) {

                    console.error(
                        error
                    );

                }

            }

            pendingIceCandidates = [];

        }


        /* =====================================================
           OPEN CALL WINDOW
           ===================================================== */

        function openCallWindow(
            user,
            type
        ) {

            callPerson.textContent =
                user;

            callType.textContent =
                type;

            voiceName.textContent =
                user;

            callAvatar.textContent =
                user
                    .substring(0, 1)
                    .toUpperCase();

            voiceStatus.textContent =
                "Calling...";

            callOverlay.classList.add(
                "show"
            );

            if (type === "Video call") {

                remoteVideo.style.display =
                    "block";

                voicePlaceholder.style.display =
                    "none";

                cameraButton.style.display =
                    "flex";

            }
            else {

                remoteVideo.style.display =
                    "none";

                localVideo.style.display =
                    "none";

                voicePlaceholder.style.display =
                    "flex";

                cameraButton.style.display =
                    "none";

            }

        }


        /* =====================================================
           CLOSE CALL
           ===================================================== */

        async function closeCall(
            notifyRemote = false
        ) {

            if (
                notifyRemote &&
                currentCallUser
            ) {

                try {

                    await connection.invoke(
                        "EndCall",
                        currentCallUser
                    );

                }
                catch (error) {

                    console.error(
                        error
                    );

                }

            }


            if (peerConnection) {

                try {

                    peerConnection.close();

                }
                catch (error) {

                    console.error(
                        error
                    );

                }

                peerConnection =
                    null;

            }


            if (localStream) {

                localStream
                    .getTracks()
                    .forEach(
                        track =>
                            track.stop()
                    );

                localStream =
                    null;

            }


            remoteVideo.srcObject =
                null;

            localVideo.srcObject =
                null;


            callOverlay.classList.remove(
                "show"
            );


            currentCallUser =
                null;

            currentCallType =
                null;

            pendingIceCandidates =
                [];

            isMuted =
                false;

            isCameraOff =
                false;

            muteButton.classList.remove(
                "active"
            );

            cameraButton.classList.remove(
                "active"
            );

            muteButton.textContent =
                "🎤";

            cameraButton.textContent =
                "📹";

        }


        /* =====================================================
           END CALL
           ===================================================== */

        endCallButton.addEventListener(
            "click",
            function () {

                closeCall(true);

            }
        );


        callCloseButton.addEventListener(
            "click",
            function () {

                closeCall(true);

            }
        );


        /* =====================================================
           MUTE
           ===================================================== */

        muteButton.addEventListener(
            "click",
            function () {

                if (!localStream) {
                    return;
                }

                const audioTracks =
                    localStream.getAudioTracks();

                if (!audioTracks.length) {
                    return;
                }

                isMuted =
                    !isMuted;

                audioTracks.forEach(
                    track =>
                        track.enabled =
                            !isMuted
                );

                muteButton.classList.toggle(
                    "active",
                    isMuted
                );

                muteButton.textContent =
                    isMuted
                        ? "🔇"
                        : "🎤";

            }
        );


        /* =====================================================
           CAMERA
           ===================================================== */

        cameraButton.addEventListener(
            "click",
            function () {

                if (!localStream) {
                    return;
                }

                const videoTracks =
                    localStream.getVideoTracks();

                if (!videoTracks.length) {
                    return;
                }

                isCameraOff =
                    !isCameraOff;

                videoTracks.forEach(
                    track =>
                        track.enabled =
                            !isCameraOff
                );

                cameraButton.classList.toggle(
                    "active",
                    isCameraOff
                );

                cameraButton.textContent =
                    isCameraOff
                        ? "🚫"
                        : "📹";

            }
        );


        /* =====================================================
           VOICE CALL BUTTON
           ===================================================== */

        voiceCallButton.addEventListener(
            "click",
            function () {

                const target =
                    getSelectedOnlineUser();

                if (!target) {

                    alert(
                        "Click an online user first."
                    );

                    return;

                }

                startVoiceCall(
                    target
                );

            }
        );


        /* =====================================================
           VIDEO CALL BUTTON
           ===================================================== */

        videoCallButton.addEventListener(
            "click",
            function () {

                const target =
                    getSelectedOnlineUser();

                if (!target) {

                    alert(
                        "Click an online user first."
                    );

                    return;

                }

                startVideoCall(
                    target
                );

            }
        );


        /* =====================================================
           SELECT ONLINE USER
           ===================================================== */

        let selectedOnlineUser =
            null;


        function getSelectedOnlineUser() {

            if (
                selectedOnlineUser &&
                onlineUsers.some(
                    x =>
                        x.toLowerCase() ===
                        selectedOnlineUser.toLowerCase()
                )
            ) {

                return selectedOnlineUser;

            }


            const available =
                onlineUsers.find(
                    x =>
                        x.toLowerCase() !==
                        currentUsername.toLowerCase()
                );

            return available || null;

        }


        /* =====================================================
           RENDER ONLINE USERS
           ===================================================== */

        function renderOnlineUsers(
            users
        ) {

            onlineUsersContainer.innerHTML =
                "";

            const search =
                userSearch.value
                    .trim()
                    .toLowerCase();


            const filtered =
                users.filter(
                    user =>
                        user
                            .toLowerCase()
                            .includes(search)
                );


            const others =
                filtered.filter(
                    user =>
                        user.toLowerCase() !==
                        currentUsername.toLowerCase()
                );


            onlineCount.textContent =
                users.length;


            if (!others.length) {

                onlineUsersContainer.innerHTML = `
                    <div class="no-users">
                        No other users online.
                    </div>
                `;

                return;

            }


            others.forEach(
                function (user) {

                    const item =
                        document.createElement("div");

                    item.className =
                        "online-user";

                    item.dataset.username =
                        user;


                    const firstLetter =
                        user
                            .substring(0, 1)
                            .toUpperCase();


                    item.innerHTML = `

                        <div class="user-avatar">

                            ${escapeHtml(firstLetter)}

                            <span class="online-dot"></span>

                        </div>

                        <div class="user-name">
                            ${escapeHtml(user)}
                        </div>

                    `;


                    item.addEventListener(
                        "click",
                        function () {

                            selectedOnlineUser =
                                user;

                            document
                                .querySelectorAll(
                                    ".online-user"
                                )
                                .forEach(
                                    el =>
                                        el.style.background =
                                            ""
                                );

                            item.style.background =
                                "#eff6ff";

                            if (
                                window.innerWidth <=
                                800
                            ) {

                                chatSidebar.classList.remove(
                                    "open"
                                );

                            }

                        }
                    );


                    onlineUsersContainer.appendChild(
                        item
                    );

                }
            );

        }


        /* =====================================================
           SEARCH USERS
           ===================================================== */

        userSearch.addEventListener(
            "input",
            function () {

                renderOnlineUsers(
                    onlineUsers
                );

            }
        );


        /* =====================================================
           SEND MESSAGE
           ===================================================== */

        async function sendMessage() {

            if (isSending) {
                return;
            }

            const message =
                messageInput.value.trim();

            if (!message) {
                return;
            }

            if (message.length > 1000) {

                alert(
                    "Message cannot exceed 1000 characters."
                );

                return;

            }


            if (
                connection.state !==
                signalR.HubConnectionState.Connected
            ) {

                alert(
                    "Chat is not connected."
                );

                return;

            }


            try {

                isSending = true;

                sendButton.disabled =
                    true;

                await connection.invoke(
                    "SendMessage",
                    message
                );

                messageInput.value =
                    "";

                autoResizeTextarea();

            }
            catch (error) {

                console.error(
                    "Send message error:",
                    error
                );

                alert(
                    "Unable to send message."
                );

            }
            finally {

                isSending =
                    false;

                sendButton.disabled =
                    false;

                messageInput.focus();

            }

        }


        sendButton.addEventListener(
            "click",
            sendMessage
        );


        /* =====================================================
           ENTER TO SEND
           ===================================================== */

        messageInput.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" &&
                    !event.shiftKey
                ) {

                    event.preventDefault();

                    sendMessage();

                }

            }
        );


        /* =====================================================
           TEXTAREA AUTO RESIZE
           ===================================================== */

        function autoResizeTextarea() {

            messageInput.style.height =
                "auto";

            messageInput.style.height =
                Math.min(
                    messageInput.scrollHeight,
                    120
                ) + "px";

        }


        messageInput.addEventListener(
            "input",
            autoResizeTextarea
        );


        /* =====================================================
           LOAD EXISTING MESSAGES
           ===================================================== */

        async function loadMessages() {

            try {

                const response =
                    await fetch(
                        "/CompanyChat/Messages",
                        {
                            method: "GET",
                            credentials: "same-origin"
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to load messages."
                    );

                }


                const messages =
                    await response.json();


                if (
                    !Array.isArray(messages)
                ) {

                    return;

                }


                messages.forEach(
                    function (item) {

                        addMessage(
                            item.id ??
                            item.Id,

                            item.username ??
                            item.Username,

                            item.message ??
                            item.Message,

                            formatMessageTime(
                                item.sentAt ??
                                item.SentAt
                            )
                        );

                    }
                );


                scrollToBottom();

            }
            catch (error) {

                console.error(
                    "Load messages error:",
                    error
                );

            }

        }


        /* =====================================================
           ADD MESSAGE
           ===================================================== */

        function addMessage(
            id,
            username,
            message,
            time
        ) {

            if (
                id !== null &&
                id !== undefined &&
                displayedMessageIds.has(id)
            ) {

                return;

            }


            if (
                id !== null &&
                id !== undefined
            ) {

                displayedMessageIds.add(id);

            }


            if (emptyChat) {

                emptyChat.remove();

            }


            const messageElement =
                document.createElement("div");


            const isMe =
                username.toLowerCase() ===
                currentUsername.toLowerCase();


            messageElement.className =
                "message " +
                (isMe ? "me" : "other");


            /* ================================================
               FILE MESSAGE
               ================================================ */

            if (
                typeof message === "string" &&
                message.startsWith("[FILE]|")
            ) {

                const parts =
                    message.split("|");


                const fileName =
                    parts[1] ||
                    "File";


                const fileUrl =
                    parts[2] ||
                    "#";


                const isImage =
                    parts[3] === "True" ||
                    parts[3] === "true";


                let attachmentHtml =
                    "";


                if (isImage) {

                    attachmentHtml = `

                        <div class="chat-image-attachment">

                            <a
                                href="${escapeAttribute(fileUrl)}"
                                target="_blank"
                                rel="noopener noreferrer">

                                <img
                                    src="${escapeAttribute(fileUrl)}"
                                    alt="${escapeAttribute(fileName)}"
                                    class="chat-image"
                                    loading="lazy" />

                            </a>

                            <div class="attachment-file-name">
                                ${escapeHtml(fileName)}
                            </div>

                        </div>

                    `;

                }
                else {

                    attachmentHtml = `

                        <a
                            href="${escapeAttribute(fileUrl)}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="chat-file-attachment"
                            download>

                            <span class="file-icon">
                                📎
                            </span>

                            <span class="file-details">

                                <strong>
                                    ${escapeHtml(fileName)}
                                </strong>

                                <small>
                                    Click to download
                                </small>

                            </span>

                        </a>

                    `;

                }


                messageElement.innerHTML = `

                    <div class="message-content">

                        ${
                            !isMe
                            ? `
                                <div class="message-username">
                                    ${escapeHtml(username)}
                                </div>
                              `
                            : ""
                        }

                        <div class="message-bubble attachment-bubble">

                            ${attachmentHtml}

                        </div>

                        <div class="message-time">
                            ${escapeHtml(time)}
                        </div>

                    </div>

                `;

            }

            /* ================================================
               NORMAL TEXT MESSAGE
               ================================================ */

            else {

                const safeMessage =
                    linkifyMessage(
                        message
                    );


                messageElement.innerHTML = `

                    <div class="message-content">

                        ${
                            !isMe
                            ? `
                                <div class="message-username">
                                    ${escapeHtml(username)}
                                </div>
                              `
                            : ""
                        }

                        <div class="message-bubble">
                            ${safeMessage}
                        </div>

                        <div class="message-time">
                            ${escapeHtml(time)}
                        </div>

                    </div>

                `;

            }


            messagesArea.appendChild(
                messageElement
            );


            scrollToBottom();

        }


        /* =====================================================
           LINKIFY
           ===================================================== */

        function linkifyMessage(
            text
        ) {

            const escaped =
                escapeHtml(text);


            const urlRegex =
                /(https?:\/\/[^\s<]+|www\.[^\s<]+)/gi;


            return escaped.replace(
                urlRegex,
                function (url) {

                    let href =
                        url;

                    if (
                        url
                            .toLowerCase()
                            .startsWith("www.")
                    ) {

                        href =
                            "https://" +
                            url;

                    }


                    return `
                        <a
                            href="${escapeAttribute(href)}"
                            target="_blank"
                            rel="noopener noreferrer">
                            ${url}
                        </a>
                    `;

                }
            );

        }


        /* =====================================================
           ESCAPE HTML
           ===================================================== */

        function escapeHtml(
            value
        ) {

            return String(value ?? "")
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }


        /* =====================================================
           ESCAPE ATTRIBUTE
           ===================================================== */

        function escapeAttribute(
            value
        ) {

            return String(value ?? "")
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                );

        }


        /* =====================================================
           TIME
           ===================================================== */

        function formatMessageTime(
            value
        ) {

            if (!value) {
                return "";
            }


            const date =
                new Date(value);


            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {

                return String(value);

            }


            return date.toLocaleTimeString(
                [],
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );

        }


        /* =====================================================
           SCROLL
           ===================================================== */

        function scrollToBottom() {

            messagesArea.scrollTop =
                messagesArea.scrollHeight;

        }


        /* =====================================================
           EMOJIS
           ===================================================== */

        const emojis = [

            "😀","😃","😄","😁",
            "😆","😅","😂","🤣",
            "😊","😇","🙂","🙃",
            "😉","😌","😍","🥰",
            "😘","😗","😙","😚",
            "😋","😛","😝","😜",
            "🤪","🤨","🧐","🤓",
            "😎","🤩","🥳","😏",
            "😒","😞","😔","😟",
            "😕","🙁","☹️","😣",
            "😖","😫","😩","🥺",
            "😢","😭","😤","😠",
            "😡","🤬","🤯","😳",
            "🥵","🥶","😱","😨",
            "😰","😥","😓","🤗",
            "🤔","🤭","🤫","🤥",
            "😶","😐","😑","😬",
            "🙄","😯","😦","😧",
            "😮","😲","🥱","😴",
            "🤤","😪","😵","🤐",
            "🥴","🤢","🤮","🤧",
            "😷","🤒","🤕","🤑",
            "🤠","👍","👎","👏",
            "🙌","🙏","❤️","🧡",
            "💛","💚","💙","💜",
            "🖤","🤍","🤎","💔",
            "🔥","✨","⭐","🎉",
            "🎊","💯","✅","❌",
            "💡","🚀","💪","👋"

        ];


        emojis.forEach(
            function (emoji) {

                const button =
                    document.createElement("button");

                button.type =
                    "button";

                button.className =
                    "emoji-item";

                button.textContent =
                    emoji;

                button.addEventListener(
                    "click",
                    function () {

                        insertEmoji(
                            emoji
                        );

                    }
                );

                emojiPicker.appendChild(
                    button
                );

            }
        );


        emojiButton.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();

                emojiPicker.classList.toggle(
                    "show"
                );

            }
        );


        document.addEventListener(
            "click",
            function (event) {

                if (
                    !emojiPicker.contains(event.target) &&
                    event.target !== emojiButton
                ) {

                    emojiPicker.classList.remove(
                        "show"
                    );

                }

            }
        );


        function insertEmoji(
            emoji
        ) {

            const start =
                messageInput.selectionStart;

            const end =
                messageInput.selectionEnd;


            const text =
                messageInput.value;


            messageInput.value =
                text.substring(
                    0,
                    start
                ) +
                emoji +
                text.substring(
                    end
                );


            messageInput.focus();


            messageInput.selectionStart =
                start +
                emoji.length;

            messageInput.selectionEnd =
                start +
                emoji.length;


            autoResizeTextarea();

        }


        /* =====================================================
           FILE UPLOAD
           ===================================================== */

        attachFileButton.addEventListener(
            "click",
            function () {

                chatFileInput.click();

            }
        );


        chatFileInput.addEventListener(
            "change",
            async function () {

                const file =
                    this.files[0];


                if (!file) {
                    return;
                }


                const maxSize =
                    10 * 1024 * 1024;


                if (
                    file.size >
                    maxSize
                ) {

                    alert(
                        "File size cannot exceed 10 MB."
                    );

                    this.value =
                        "";

                    return;

                }


                const allowedExtensions = [

                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".gif",
                    ".webp",
                    ".pdf",
                    ".doc",
                    ".docx",
                    ".xls",
                    ".xlsx",
                    ".zip"

                ];


                const extension =
                    "." +
                    file.name
                        .split(".")
                        .pop()
                        .toLowerCase();


                if (
                    !allowedExtensions.includes(
                        extension
                    )
                ) {

                    alert(
                        "This file type is not allowed."
                    );

                    this.value =
                        "";

                    return;

                }


                try {

                    attachFileButton.disabled =
                        true;

                    uploadingIndicator.classList.add(
                        "show"
                    );


                    const formData =
                        new FormData();


                    formData.append(
                        "file",
                        file
                    );


                    const response =
                        await fetch(
                            "/CompanyChat/UploadFile",
                            {
                                method: "POST",
                                body: formData,
                                credentials: "same-origin"
                            }
                        );


                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message ||
                            "File upload failed."
                        );

                    }


                    await connection.invoke(
                        "SendFileMessage",
                        result.fileName,
                        result.fileUrl,
                        result.isImage
                    );


                }
                catch (error) {

                    console.error(
                        "Upload error:",
                        error
                    );

                    alert(
                        error.message ||
                        "Unable to upload file."
                    );

                }
                finally {

                    attachFileButton.disabled =
                        false;

                    uploadingIndicator.classList.remove(
                        "show"
                    );

                    this.value =
                        "";

                }

            }
        );


        /* =====================================================
           MOBILE SIDEBAR
           ===================================================== */

        mobileMenuButton.addEventListener(
            "click",
            function () {

                chatSidebar.classList.toggle(
                    "open"
                );

            }
        );


        /* =====================================================
           SIGNALR STATUS
           ===================================================== */

        connection.onreconnecting(
            function () {

                connectionStatus.textContent =
                    "Reconnecting...";

                connectionStatus.classList.add(
                    "visible"
                );

            }
        );


        connection.onreconnected(
            function () {

                connectionStatus.classList.remove(
                    "visible"
                );

            }
        );


        connection.onclose(
            function () {

                connectionStatus.textContent =
                    "Disconnected";

                connectionStatus.classList.add(
                    "visible"
                );

            }
        );


        /* =====================================================
           START CHAT
           ===================================================== */

        async function startChat() {

            try {

                await connection.start();

                connectionStatus.classList.remove(
                    "visible"
                );

                console.log(
                    "Company Chat connected."
                );


                await loadMessages();

            }
            catch (error) {

                console.error(
                    "SignalR connection failed:",
                    error
                );


                connectionStatus.textContent =
                    "Connection failed";

                connectionStatus.classList.add(
                    "visible"
                );


                setTimeout(
                    startChat,
                    5000
                );

            }

        }


        /* =====================================================
           START
           ===================================================== */

        startChat();

    </script>

</body>
</html>