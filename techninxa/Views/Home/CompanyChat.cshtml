@using Microsoft.AspNetCore.Http

@{
    var username = Context.Session.GetString("CompanyChatUsername") ?? "Employee";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Company Chat</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f5f7fb;
            color: #111827;
            overflow: hidden;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =====================================================
           MAIN APP
           ===================================================== */

        .chat-app {
            width: 100%;
            height: 100vh;
            display: flex;
            overflow: hidden;
            background: #ffffff;
        }

        /* =====================================================
           SIDEBAR
           ===================================================== */

        .chat-sidebar {
            width: 285px;
            min-width: 285px;
            height: 100%;
            border-right: 1px solid #e5e7eb;
            background: #ffffff;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #e5e7eb;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: #111827;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 17px;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
        }

        .brand-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 16px;
            font-weight: 700;
        }

        .brand-subtitle {
            font-size: 11px;
            color: #9ca3af;
            margin-top: 2px;
        }

        /* =====================================================
           SEARCH
           ===================================================== */

        .search-container {
            padding: 15px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            width: 100%;
            height: 39px;
            border: 1px solid #e5e7eb;
            border-radius: 9px;
            padding: 0 12px 0 36px;
            outline: none;
            background: #f9fafb;
            font-size: 13px;
        }

        .search-box input:focus {
            border-color: #93c5fd;
            background: #ffffff;
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: #9ca3af;
            pointer-events: none;
        }

        /* =====================================================
           SIDEBAR SECTION
           ===================================================== */

        .sidebar-section {
            padding: 0 12px;
        }

        .section-title {
            padding: 7px 8px;
            color: #9ca3af;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .chat-room {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 11px;
            border-radius: 9px;
            cursor: pointer;
            background: #eff6ff;
            color: #1d4ed8;
        }

        .room-icon {
            width: 33px;
            height: 33px;
            border-radius: 9px;
            background: #2563eb;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .room-info {
            min-width: 0;
        }

        .room-name {
            font-size: 13px;
            font-weight: 600;
        }

        .room-description {
            margin-top: 2px;
            color: #6b7280;
            font-size: 10px;
        }

        /* =====================================================
           ONLINE USERS
           ===================================================== */

        .online-users-container {
            flex: 1;
            overflow-y: auto;
            padding: 10px 12px;
        }

        .online-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            border-radius: 8px;
        }

        .online-user:hover {
            background: #f9fafb;
        }

        .user-avatar {
            position: relative;
            width: 32px;
            height: 32px;
            min-width: 32px;
            border-radius: 50%;
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            color: #374151;
        }

        .online-dot {
            position: absolute;
            width: 9px;
            height: 9px;
            right: -1px;
            bottom: -1px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            background: #22c55e;
        }

        .user-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 13px;
            font-weight: 500;
        }

        .no-users {
            padding: 15px 8px;
            color: #9ca3af;
            font-size: 12px;
        }

        /* =====================================================
           CURRENT USER
           ===================================================== */

        .current-user {
            border-top: 1px solid #e5e7eb;
            padding: 13px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .current-user-info {
            min-width: 0;
            flex: 1;
        }

        .current-user-name {
            font-size: 12px;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .current-user-status {
            margin-top: 2px;
            color: #22c55e;
            font-size: 10px;
        }

        /* =====================================================
           MAIN CHAT
           ===================================================== */

        .chat-main {
            min-width: 0;
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            background: #ffffff;
        }

        .chat-header {
            min-height: 70px;
            border-bottom: 1px solid #e5e7eb;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .chat-header-left {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
        }

        .mobile-menu-button {
            display: none;
            width: 36px;
            height: 36px;
            border: 0;
            background: #f3f4f6;
            border-radius: 8px;
            font-size: 18px;
        }

        .header-room-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 10px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 16px;
            font-weight: 700;
        }

        .header-status {
            margin-top: 3px;
            color: #22c55e;
            font-size: 10px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .call-button {
            width: 39px;
            height: 39px;
            border: 1px solid #e5e7eb;
            border-radius: 9px;
            background: #ffffff;
            font-size: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .call-button:hover {
            background: #f3f4f6;
        }

        .call-button:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

        /* =====================================================
           CONNECTION
           ===================================================== */

        .connection-status {
            position: absolute;
            top: 80px;
            right: 20px;
            z-index: 10;
            display: none;
            padding: 6px 10px;
            border-radius: 7px;
            background: #fef2f2;
            color: #dc2626;
            font-size: 10px;
            font-weight: 600;
        }

        .connection-status.visible {
            display: block;
        }

        /* =====================================================
           MESSAGES
           ===================================================== */

        .messages-area {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            padding: 25px;
            background: #fafafa;
        }

        .message {
            display: flex;
            margin-bottom: 14px;
        }

        .message.me {
            justify-content: flex-end;
        }

        .message.other {
            justify-content: flex-start;
        }

        .message-content {
            max-width: min(70%, 650px);
        }

        .message-username {
            margin: 0 0 4px 4px;
            color: #6b7280;
            font-size: 10px;
            font-weight: 600;
        }

        .message-bubble {
            width: fit-content;
            max-width: 100%;
            padding: 10px 13px;
            border-radius: 13px;
            background: #f1f3f5;
            color: #111827;
            font-size: 13px;
            line-height: 1.5;
            word-break: break-word;
        }

        .message.me .message-bubble {
            background: #2563eb;
            color: #ffffff;
            border-bottom-right-radius: 4px;
        }

        .message.other .message-bubble {
            border-bottom-left-radius: 4px;
        }

        .message-bubble a {
            color: inherit;
            text-decoration: underline;
            word-break: break-all;
        }

        .message-time {
            margin-top: 3px;
            padding: 0 4px;
            color: #9ca3af;
            font-size: 9px;
        }

        .message.me .message-time {
            text-align: right;
        }

        /* =====================================================
           EMPTY CHAT
           ===================================================== */

        .empty-chat {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .empty-chat-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 12px;
            border-radius: 16px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .empty-chat-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 18px;
            font-weight: 700;
        }

        .empty-chat-text {
            margin-top: 5px;
            color: #9ca3af;
            font-size: 12px;
        }

        /* =====================================================
           COMPOSER
           ===================================================== */

        .composer-container {
            padding: 13px 18px 17px;
            border-top: 1px solid #e5e7eb;
            background: #ffffff;
        }

        .composer {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            border: 1px solid #e5e7eb;
            border-radius: 13px;
            padding: 7px;
            background: #ffffff;
        }

        .composer:focus-within {
            border-color: #93c5fd;
        }

        .composer-action {
            width: 35px;
            height: 35px;
            min-width: 35px;
            border: 0;
            border-radius: 8px;
            background: #f3f4f6;
            color: #4b5563;
            font-size: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .composer-action:hover {
            background: #e5e7eb;
        }

        .composer-action:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        #messageInput {
            flex: 1;
            min-width: 0;
            min-height: 35px;
            max-height: 120px;
            resize: none;
            border: 0;
            outline: none;
            padding: 8px 5px;
            font-size: 13px;
            line-height: 1.4;
        }

        .send-button {
            width: 35px;
            height: 35px;
            min-width: 35px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: #ffffff;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .send-button:hover {
            background: #1d4ed8;
        }

        .send-button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        /* =====================================================
           EMOJI PICKER
           ===================================================== */

        .emoji-wrapper {
            position: relative;
        }

        .emoji-picker {
            position: absolute;
            bottom: 48px;
            left: 0;
            width: 280px;
            max-height: 260px;
            overflow-y: auto;
            padding: 10px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 10px 35px rgba(0, 0, 0, .12);
            display: none;
            z-index: 100;
        }

        .emoji-picker.show {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 3px;
        }

        .emoji-item {
            width: 29px;
            height: 29px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            font-size: 18px;
        }

        .emoji-item:hover {
            background: #f3f4f6;
        }

        /* =====================================================
           FILE ATTACHMENTS
           ===================================================== */

        .attachment-bubble {
            padding: 6px !important;
        }

        .chat-image-attachment {
            max-width: 280px;
        }

        .chat-image {
            display: block;
            max-width: 280px;
            max-height: 320px;
            width: auto;
            height: auto;
            border-radius: 9px;
            cursor: pointer;
        }

        .attachment-file-name {
            padding: 7px 8px 3px;
            font-size: 12px;
            word-break: break-word;
        }

        .chat-file-attachment {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 210px;
            max-width: 300px;
            padding: 10px;
            border-radius: 9px;
            color: inherit;
            text-decoration: none;
        }

        .chat-file-attachment:hover {
            background: rgba(0, 0, 0, .05);
        }

        .file-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 8px;
            background: rgba(37, 99, 235, .1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .file-details {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .file-details strong {
            font-size: 12px;
            font-weight: 600;
            word-break: break-word;
        }

        .file-details small {
            margin-top: 3px;
            font-size: 10px;
            opacity: .65;
        }

        /* =====================================================
           CALL MODAL
           ===================================================== */

        .call-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(17, 24, 39, .72);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .call-overlay.show {
            display: flex;
        }

        .call-window {
            position: relative;
            width: min(900px, 100%);
            height: min(650px, 90vh);
            overflow: hidden;
            border-radius: 18px;
            background: #111827;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .35);
        }

        .call-topbar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 20;
            height: 60px;
            padding: 0 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #ffffff;
            background: linear-gradient(
                to bottom,
                rgba(0,0,0,.45),
                transparent
            );
        }

        .call-person {
            font-size: 13px;
            font-weight: 600;
        }

        .call-type {
            margin-top: 2px;
            color: rgba(255,255,255,.65);
            font-size: 10px;
        }

        .call-close {
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            color: #ffffff;
            font-size: 17px;
        }

        .remote-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            background: #111827;
        }

        .local-video {
            position: absolute;
            right: 18px;
            bottom: 95px;
            z-index: 15;
            width: 180px;
            height: 125px;
            object-fit: cover;
            border-radius: 12px;
            background: #1f2937;
            border: 2px solid rgba(255,255,255,.3);
        }

        .voice-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            color: #ffffff;
        }

        .voice-avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 35px;
            font-weight: 700;
        }

        .voice-name {
            margin-top: 15px;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 19px;
            font-weight: 700;
        }

        .voice-status {
            margin-top: 5px;
            color: rgba(255,255,255,.6);
            font-size: 12px;
        }

        .call-controls {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 20px;
            z-index: 30;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .call-control {
            width: 48px;
            height: 48px;
            border: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.14);
            color: #ffffff;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .call-control:hover {
            background: rgba(255,255,255,.23);
        }

        .call-control.active {
            background: #ffffff;
            color: #111827;
        }

        .call-control.end-call {
            background: #ef4444;
        }

        .call-control.end-call:hover {
            background: #dc2626;
        }

        /* =====================================================
           INCOMING CALL
           ===================================================== */

        .incoming-call {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1100;
            width: 320px;
            padding: 18px;
            border-radius: 15px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            box-shadow: 0 18px 50px rgba(0,0,0,.18);
            display: none;
        }

        .incoming-call.show {
            display: block;
        }

        .incoming-title {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

        .incoming-text {
            margin-top: 4px;
            color: #6b7280;
            font-size: 12px;
        }

        .incoming-actions {
            display: flex;
            gap: 8px;
            margin-top: 15px;
        }

        .incoming-actions button {
            flex: 1;
            height: 38px;
            border: 0;
            border-radius: 8px;
            font-weight: 600;
        }

        .accept-call {
            background: #22c55e;
            color: #ffffff;
        }

        .reject-call {
            background: #fee2e2;
            color: #dc2626;
        }

        /* =====================================================
           LOADING
           ===================================================== */

        .uploading-indicator {
            position: fixed;
            left: 50%;
            bottom: 80px;
            transform: translateX(-50%);
            z-index: 500;
            display: none;
            padding: 8px 13px;
            border-radius: 8px;
            background: #111827;
            color: #ffffff;
            font-size: 11px;
            box-shadow: 0 8px 30px rgba(0,0,0,.2);
        }

        .uploading-indicator.show {
            display: block;
        }

        /* =====================================================
           MOBILE
           ===================================================== */

        @@media (max-width: 800px) {

            .chat-sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: -290px;
                z-index: 900;
                transition: left .2s ease;
                box-shadow: 10px 0 30px rgba(0,0,0,.08);
            }

            .chat-sidebar.open {
                left: 0;
            }

            .mobile-menu-button {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .chat-header {
                padding: 0 12px;
            }

            .messages-area {
                padding: 15px;
            }

            .message-content {
                max-width: 82%;
            }

            .composer-container {
                padding: 10px;
            }

            .call-window {
                width: 100%;
                height: 100%;
                max-height: none;
                border-radius: 0;
            }

            .local-video {
                width: 125px;
                height: 90px;
                right: 10px;
                bottom: 90px;
            }

            .incoming-call {
                left: 15px;
                right: 15px;
                bottom: 15px;
                width: auto;
            }
        }

        @@media (max-width: 500px) {

            .header-room-icon {
                display: none;
            }

            .header-title {
                font-size: 14px;
            }

            .header-actions {
                gap: 4px;
            }

            .call-button {
                width: 34px;
                height: 34px;
            }

            .chat-image {
                max-width: 220px;
                max-height: 260px;
            }

            .chat-file-attachment {
                min-width: 180px;
                max-width: 240px;
            }

            .emoji-picker {
                width: 250px;
            }
        }

    </style>
</head>

<body>

    <div class="chat-app">

        <!-- ==================================================
             SIDEBAR
             ================================================== -->

        <aside class="chat-sidebar" id="chatSidebar">

            <div class="sidebar-header">

                <div class="brand">

                    <div class="brand-logo">
                        T
                    </div>

                    <div class="brand-text">

                        <div class="brand-title">
                            Techninxa
                        </div>

                        <div class="brand-subtitle">
                            Company Chat
                        </div>

                    </div>

                </div>

            </div>

            <div class="search-container">

                <div class="search-box">

                    <span class="search-icon">
                        🔎
                    </span>

                    <input
                        type="text"
                        id="userSearch"
                        placeholder="Search people..." />

                </div>

            </div>

            <div class="sidebar-section">

                <div class="section-title">
                    Rooms
                </div>

                <div class="chat-room">

                    <div class="room-icon">
                        💬
                    </div>

                    <div class="room-info">

                        <div class="room-name">
                            Company General
                        </div>

                        <div class="room-description">
                            Team conversation
                        </div>

                    </div>

                </div>

            </div>

            <div class="sidebar-section"
                 style="margin-top:12px;">

                <div class="section-title">
                    Online
                </div>

            </div>

            <div class="online-users-container"
                 id="onlineUsers">

                <div class="no-users">
                    Connecting...
                </div>

