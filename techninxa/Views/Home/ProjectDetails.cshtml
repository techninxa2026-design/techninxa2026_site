@using Techninxa.Models
@model Project

@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveNav"] = "Projects";
    ViewData["Description"] =
        Model.ShortDescription ??
        $"{Model.Title} — Techninxa project case study.";

    var imageMedia = Model.Media
        .Where(m => m.MediaType == "image")
        .OrderBy(m => m.DisplayOrder)
        .ToList();

    var videoMedia = Model.Media
        .Where(m => m.MediaType == "video")
        .OrderBy(m => m.DisplayOrder)
        .ToList();

    var overview = string.IsNullOrWhiteSpace(Model.Overview)
        ? Model.ShortDescription
        : Model.Overview;
}

<section class="project-details-page">

    <div class="project-details-container">

        <!-- =========================================
             HERO
        ========================================== -->

        <section class="project-details-hero">

            <a href="/Projects" class="project-details-back">
                ← Back to Projects
            </a>

            <div class="project-details-category">
                <span></span>
                @Model.Category
            </div>

            <h1>
                @Model.Title
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
            {
                <p class="project-details-intro">
                    @Model.ShortDescription
                </p>
            }

            <div class="project-details-actions">

                @if (!string.IsNullOrWhiteSpace(Model.ProjectUrl))
                {
                    <a href="@Model.ProjectUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="project-details-btn project-details-btn-primary">
                        Explore Project
                        <span>↗</span>
                    </a>
                }

                <a href="#project-overview"
                   class="project-details-btn project-details-btn-secondary">
                    View Case Study
                    <span>↓</span>
                </a>

            </div>

        </section>


        <!-- =========================================
             HERO IMAGE
        ========================================== -->

        <section class="project-details-hero-media">

            @if (!string.IsNullOrWhiteSpace(Model.HeroImage))
            {
                <img src="@Model.HeroImage"
                     alt="@Model.Title"
                     loading="eager">
            }
            else
            {
                <div class="project-details-media-placeholder">
                    <span>@Model.Title</span>
                </div>
            }

        </section>


        <!-- =========================================
             PROJECT META
        ========================================== -->

        <section class="project-details-meta">

            <div class="project-meta-item">

                <span class="project-meta-label">
                    Client
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Client)
                        ? "Private Project"
                        : Model.Client)
                </strong>

            </div>


            <div class="project-meta-item">

                <span class="project-meta-label">
                    Year
                </span>

                <strong>
                    @(Model.Year?.ToString() ?? "—")
                </strong>

            </div>


            <div class="project-meta-item">

                <span class="project-meta-label">
                    Category
                </span>

                <strong>
                    @Model.Category
                </strong>

            </div>


            <div class="project-meta-item">

                <span class="project-meta-label">
                    Status
                </span>

                <strong class="project-published-status">
                    Published
                </strong>

            </div>

        </section>


        <!-- =========================================
             OVERVIEW
        ========================================== -->

        <section class="project-details-section"
                 id="project-overview">

            <div class="project-section-heading">

                <span class="project-section-number">
                    01
                </span>

                <div>

                    <span class="project-section-kicker">
                        Project Story
                    </span>

                    <h2>
                        Overview
                    </h2>

                </div>

            </div>


            <div class="project-overview-content">

                @if (!string.IsNullOrWhiteSpace(overview))
                {
                    <div class="project-overview-main">

                        <p>
                            @overview
                        </p>

                    </div>
                }
                else
                {
                    <div class="project-overview-main">

                        <p>
                            No project overview has been added yet.
                        </p>

                    </div>
                }

            </div>

        </section>


        <!-- =========================================
             TECHNOLOGIES
        ========================================== -->

        @if (Model.Technologies != null &&
             Model.Technologies.Any())
        {
            <section class="project-details-section">

                <div class="project-section-heading">

                    <span class="project-section-number">
                        02
                    </span>

                    <div>

                        <span class="project-section-kicker">
                            Tech Stack
                        </span>

                        <h2>
                            Technologies
                        </h2>

                    </div>

                </div>


                <div class="project-technology-list">

                    @foreach (var technology in Model.Technologies)
                    {
                        <div class="project-technology-item">

                            <span class="project-tech-dot"></span>

                            <span>
                                @technology.Name
                            </span>

                        </div>
                    }

                </div>

            </section>
        }


        <!-- =========================================
             FEATURES
        ========================================== -->

        @if (Model.Features != null &&
             Model.Features.Any())
        {
            <section class="project-details-section">

                <div class="project-section-heading">

                    <span class="project-section-number">
                        03
                    </span>

                    <div>

                        <span class="project-section-kicker">
                            Highlights
                        </span>

                        <h2>
                            Project Features
                        </h2>

                    </div>

                </div>


                <div class="project-features-grid">

                    @foreach (var feature in Model.Features)
                    {
                        <article class="project-feature-card">

                            <div class="project-feature-number">
                                @((feature.DisplayOrder + 1)
                                    .ToString("00"))
                            </div>

                            <div class="project-feature-content">

                                <h3>
                                    @feature.Title
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(
                                    feature.Description))
                                {
                                    <p>
                                        @feature.Description
                                    </p>
                                }

                            </div>

                        </article>
                    }

                </div>

            </section>
        }


        <!-- =========================================
             PROJECT IMAGES
        ========================================== -->

        @if (imageMedia.Any())
        {
            <section class="project-details-section project-gallery-section">

                <div class="project-section-heading">

                    <span class="project-section-number">
                        04
                    </span>

                    <div>

                        <span class="project-section-kicker">
                            Visual Showcase
                        </span>

                        <h2>
                            Project Images
                        </h2>

                    </div>

                </div>


                <p class="project-section-description">
                    Screenshots, interface designs and visuals from
                    the @Model.Title project.
                </p>


                <div class="project-image-gallery">

                    @foreach (var image in imageMedia)
                    {
                        <a href="@image.FilePath"
                           class="project-gallery-image"
                           target="_blank"
                           rel="noopener noreferrer">

                            <img src="@image.FilePath"
                                 alt="@(
                                     string.IsNullOrWhiteSpace(
                                         image.OriginalFileName)
                                         ? Model.Title
                                         : image.OriginalFileName
                                 )"
                                 loading="lazy">

                            <div class="project-gallery-overlay">
                                <span>↗</span>
                            </div>

                        </a>
                    }

                </div>

            </section>
        }


        <!-- =========================================
             PROJECT VIDEOS
        ========================================== -->

        @if (videoMedia.Any())
        {
            <section class="project-details-section project-video-gallery-section">

                <div class="project-section-heading">

                    <span class="project-section-number">
                        05
                    </span>

                    <div>

                        <span class="project-section-kicker">
                            Demonstration
                        </span>

                        <h2>
                            Project Videos
                        </h2>

                    </div>

                </div>


                <p class="project-section-description">
                    Demonstration videos and project walkthroughs.
                </p>


                <div class="project-video-gallery">

                    @foreach (var video in videoMedia)
                    {
                        <article class="project-video-card">

                            <div class="project-video-wrapper">

                                <video
    controls
    preload="metadata"
    playsinline
    class="project-video">

    <source
        src="@Url.Content(video.FilePath)"
        type="video/mp4">

    Your browser does not support the video player.
</video>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                video.OriginalFileName))
                            {
                                <div class="project-video-info">

                                    <span>
                                        Project Video
                                    </span>

                                    <strong>
                                        @video.OriginalFileName
                                    </strong>

                                </div>
                            }

                        </article>
                    }

                </div>

            </section>
        }


        <!-- =========================================
             MEDIA EMPTY STATE
        ========================================== -->

        @if (!imageMedia.Any() && !videoMedia.Any())
        {
            <section class="project-details-section">

                <div class="project-media-empty">

                    <div class="project-empty-icon">
                        +
                    </div>

                    <h3>
                        More project media coming soon
                    </h3>

                    <p>
                        Additional images and videos have not been
                        added to this project yet.
                    </p>

                </div>

            </section>
        }


        <!-- =========================================
             LIVE PROJECT
        ========================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.ProjectUrl))
        {
            <section class="project-details-cta">

                <div>

                    <span class="project-section-kicker">
                        Want to explore it?
                    </span>

                    <h2>
                        Visit the live project.
                    </h2>

                </div>

                <a href="@Model.ProjectUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="project-details-btn project-details-btn-primary">

                    Open Project
                    <span>↗</span>

                </a>

            </section>
        }


        <!-- =========================================
             NEXT PROJECT
        ========================================== -->

        @if (Model.NextProject != null)
        {
            <section class="project-next-section">

                <div>

                    <span class="project-section-kicker">
                        Next Project
                    </span>

                    <h2>
                        @Model.NextProject.Title
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.NextProject.ShortDescription))
                    {
                        <p>
                            @Model.NextProject.ShortDescription
                        </p>
                    }

                </div>


                <a href="/Projects/Details/@Model.NextProject.Slug"
                   class="project-next-link">

                    View Next Project
                    <span>→</span>

                </a>

            </section>
        }
        else
        {
            <section class="project-next-section">

                <div>

                    <span class="project-section-kicker">
                        Explore More
                    </span>

                    <h2>
                        View all projects.
                    </h2>

                </div>


                <a href="/Projects"
                   class="project-next-link">

                    All Projects
                    <span>→</span>

                </a>

            </section>
        }

    </div>

</section>


@section Styles {

<style>

    /* =====================================================
       PROJECT DETAILS PAGE
    ===================================================== */

    .project-details-page {
        padding: 90px 0 110px;
        min-height: 100vh;
    }

    .project-details-container {
        width: min(1240px, calc(100% - 40px));
        margin: 0 auto;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .project-details-hero {
        max-width: 900px;
        margin: 0 auto 55px;
        text-align: center;
    }

    .project-details-back {
        display: inline-block;
        margin-bottom: 30px;
        color: #667085;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s ease;
    }

    .project-details-back:hover {
        color: #1687f8;
    }

    .project-details-category {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 17px;
        color: #1687f8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
    }

    .project-details-category span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #1687f8;
    }

    .project-details-hero h1 {
        margin: 0;
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(48px, 7vw, 88px);
        line-height: .98;
        letter-spacing: -4px;
        color: #0b1018;
    }

    .project-details-intro {
        max-width: 720px;
        margin: 25px auto 0;
        color: #667085;
        font-size: 16px;
        line-height: 1.8;
    }

    .project-details-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .project-details-btn {
        min-height: 46px;
        padding: 0 20px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: .2s ease;
    }

    .project-details-btn-primary {
        background: #0b1018;
        color: #fff;
    }

    .project-details-btn-primary:hover {
        background: #1687f8;
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(22,135,248,.18);
    }

    .project-details-btn-secondary {
        border: 1px solid #e5e9ef;
        background: #fff;
        color: #0b1018;
    }

    .project-details-btn-secondary:hover {
        border-color: #1687f8;
        color: #1687f8;
    }


    /* =====================================================
       HERO IMAGE
    ===================================================== */

    .project-details-hero-media {
        width: 100%;
        min-height: 500px;
        border-radius: 26px;
        overflow: hidden;
        background: #0b1018;
        margin-bottom: 25px;
        box-shadow: 0 25px 70px rgba(11,16,24,.12);
    }

    .project-details-hero-media img {
        width: 100%;
        height: 100%;
        min-height: 500px;
        display: block;
        object-fit: cover;
    }

    .project-details-media-placeholder {
        min-height: 500px;
        display: grid;
        place-items: center;
        color: #667085;
        font-family: "Space Grotesk", sans-serif;
        font-size: 20px;
    }


    /* =====================================================
       META
    ===================================================== */

    .project-details-meta {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        background: #fff;
        overflow: hidden;
        margin-bottom: 80px;
    }

    .project-meta-item {
        padding: 22px 25px;
        border-right: 1px solid #e5e9ef;
    }

    .project-meta-item:last-child {
        border-right: none;
    }

    .project-meta-label {
        display: block;
        margin-bottom: 7px;
        color: #98a2b3;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .project-meta-item strong {
        color: #0b1018;
        font-size: 13px;
    }

    .project-published-status {
        color: #16a34a !important;
    }


    /* =====================================================
       SECTIONS
    ===================================================== */

    .project-details-section {
        margin-bottom: 90px;
    }

    .project-section-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 35px;
    }

    .project-section-number {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #f0f7ff;
        color: #1687f8;
        font-size: 11px;
        font-weight: 800;
    }

    .project-section-kicker {
        display: block;
        margin-bottom: 7px;
        color: #1687f8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .project-section-heading h2 {
        margin: 0;
        color: #0b1018;
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(28px, 4vw, 42px);
        letter-spacing: -1.5px;
    }

    .project-section-description {
        max-width: 650px;
        margin: -12px 0 28px;
        color: #667085;
        font-size: 13px;
        line-height: 1.8;
    }


    /* =====================================================
       OVERVIEW
    ===================================================== */

    .project-overview-content {
        max-width: 900px;
        padding-left: 60px;
    }

    .project-overview-main p {
        margin: 0;
        color: #475467;
        font-size: 17px;
        line-height: 1.9;
        white-space: pre-line;
    }


    /* =====================================================
       TECHNOLOGIES
    ===================================================== */

    .project-technology-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .project-technology-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 15px;
        border: 1px solid #e5e9ef;
        border-radius: 10px;
        background: #fff;
        color: #0b1018;
        font-size: 12px;
        font-weight: 700;
    }

    .project-tech-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #1687f8;
    }


    /* =====================================================
       FEATURES
    ===================================================== */

    .project-features-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .project-feature-card {
        display: flex;
        gap: 18px;
        padding: 25px;
        border: 1px solid #e5e9ef;
        border-radius: 17px;
        background: #fff;
        transition: .25s ease;
    }

    .project-feature-card:hover {
        transform: translateY(-3px);
        border-color: #cfe6ff;
        box-shadow: 0 15px 35px rgba(11,16,24,.06);
    }

    .project-feature-number {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: #f0f7ff;
        color: #1687f8;
        font-size: 10px;
        font-weight: 800;
    }

    .project-feature-content h3 {
        margin: 0 0 8px;
        color: #0b1018;
        font-family: "Space Grotesk", sans-serif;
        font-size: 17px;
    }

    .project-feature-content p {
        margin: 0;
        color: #667085;
        font-size: 12px;
        line-height: 1.7;
    }


    /* =====================================================
       IMAGE GALLERY
    ===================================================== */

    .project-image-gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .project-gallery-image {
        position: relative;
        display: block;
        min-height: 300px;
        border-radius: 18px;
        overflow: hidden;
        background: #0b1018;
        text-decoration: none;
    }

    .project-gallery-image:first-child {
        grid-column: 1 / -1;
    }

    .project-gallery-image:first-child img {
        min-height: 500px;
    }

    .project-gallery-image img {
        width: 100%;
        height: 100%;
        min-height: 300px;
        display: block;
        object-fit: cover;
        transition: transform .45s ease;
    }

    .project-gallery-overlay {
        position: absolute;
        inset: auto 15px 15px auto;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(11,16,24,.75);
        color: #fff;
        opacity: 0;
        transform: translateY(8px);
        transition: .25s ease;
    }

    .project-gallery-image:hover img {
        transform: scale(1.035);
    }

    .project-gallery-image:hover .project-gallery-overlay {
        opacity: 1;
        transform: translateY(0);
    }


    /* =====================================================
       VIDEO GALLERY
    ===================================================== */

    .project-video-gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .project-video-card {
        overflow: hidden;
        border: 1px solid #e5e9ef;
        border-radius: 18px;
        background: #fff;
    }

    .project-video-wrapper {
        background: #0b1018;
    }

    .project-video-wrapper video {
        width: 100%;
        aspect-ratio: 16 / 9;
        display: block;
        object-fit: contain;
        background: #0b1018;
    }

    .project-video-info {
        padding: 15px 17px;
    }

    .project-video-info span {
        display: block;
        margin-bottom: 5px;
        color: #1687f8;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .project-video-info strong {
        color: #0b1018;
        font-size: 11px;
        word-break: break-word;
    }


    /* =====================================================
       EMPTY MEDIA
    ===================================================== */

    .project-media-empty {
        padding: 55px 30px;
        border: 1px dashed #d0d5dd;
        border-radius: 18px;
        text-align: center;
        background: #fafbfc;
    }

    .project-empty-icon {
        width: 45px;
        height: 45px;
        margin: 0 auto 12px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #f0f7ff;
        color: #1687f8;
        font-size: 22px;
    }

    .project-media-empty h3 {
        margin: 0 0 7px;
        color: #0b1018;
        font-family: "Space Grotesk", sans-serif;
        font-size: 18px;
    }

    .project-media-empty p {
        margin: 0;
        color: #667085;
        font-size: 12px;
    }


    /* =====================================================
       CTA
    ===================================================== */

    .project-details-cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 35px;
        margin-bottom: 25px;
        border-radius: 22px;
        background: #f0f7ff;
        border: 1px solid #d9ecff;
    }

    .project-details-cta h2 {
        margin: 0;
        color: #0b1018;
        font-family: "Space Grotesk", sans-serif;
        font-size: 30px;
        letter-spacing: -1px;
    }


    /* =====================================================
       NEXT PROJECT
    ===================================================== */

    .project-next-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 40px 0;
        border-top: 1px solid #e5e9ef;
    }

    .project-next-section h2 {
        margin: 0;
        color: #0b1018;
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(28px, 4vw, 46px);
        letter-spacing: -1.5px;
    }

    .project-next-section p {
        max-width: 600px;
        margin: 10px 0 0;
        color: #667085;
        font-size: 13px;
        line-height: 1.7;
    }

    .project-next-link {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 13px 18px;
        border-radius: 10px;
        background: #0b1018;
        color: #fff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: .2s ease;
    }

    .project-next-link:hover {
        background: #1687f8;
        transform: translateY(-2px);
    }


    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @@media (max-width: 850px) {

        .project-details-page {
            padding-top: 60px;
        }

        .project-details-hero h1 {
            letter-spacing: -2.5px;
        }

        .project-details-hero-media,
        .project-details-hero-media img,
        .project-details-media-placeholder {
            min-height: 360px;
        }

        .project-details-meta {
            grid-template-columns: repeat(2, 1fr);
        }

        .project-meta-item:nth-child(2) {
