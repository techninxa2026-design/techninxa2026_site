@model List<techninxa.Models.Meeting>

@{
    ViewData["Title"] = "Meetings";
    ViewData["ActiveNav"] = "Meetings";
}

<style>
    .meetings-page {
        height: 1000px;
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .meetings-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .meetings-header h1 {
       
        font-size: 30px;
        font-weight: 700;
        color: #0f172a;
    }

    .meetings-header p {
        margin: 7px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .meeting-count {
        padding: 10px 16px;
        border-radius: 12px;
        background: #eff6ff;
        color: #1687f8;
        font-size: 14px;
        font-weight: 600;
    }

    .meetings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 20px;
    }

    .meeting-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 22px;
        transition: .25s ease;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .04);
    }

    .meeting-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(15, 23, 42, .08);
        border-color: #bfdbfe;
    }

    .meeting-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

    .client-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .client-avatar {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: linear-gradient(135deg, #1687f8, #38bdf8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
    }

    .client-name {
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 3px;
    }

    .client-email {
        font-size: 12px;
        color: #64748b;
        word-break: break-word;
    }

    .status {
        padding: 6px 10px;
        border-radius: 20px;
        background: #ecfdf5;
        color: #059669;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .meeting-info {
        display: grid;
        gap: 10px;
        margin-bottom: 18px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 12px;
        border-radius: 12px;
        background: #f8fafc;
    }

    .info-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: #eff6ff;
        color: #1687f8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 13px;
    }

    .info-content {
        min-width: 0;
    }

    .info-label {
        display: block;
        font-size: 10px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 2px;
    }

    .info-value {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
    }

    .project-type {
        display: inline-block;
        margin-bottom: 15px;
        padding: 7px 10px;
        border-radius: 9px;
        background: #f1f5f9;
        color: #475569;
        font-size: 11px;
        font-weight: 600;
    }

    .message-box {
        padding: 13px;
        border-radius: 12px;
        background: #f8fafc;
        margin-bottom: 18px;
    }

    .message-title {
        font-size: 10px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 6px;
    }

    .message-text {
        color: #475569;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .meeting-actions {
        display: flex;
        gap: 10px;
        padding-top: 5px;
    }

    .join-btn {
        flex: 1;
        border: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 16px;
        border-radius: 12px;
        background: #1687f8;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
    }

    .join-btn:hover {
        background: #0875df;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .empty-meetings {
        text-align: center;
        padding: 70px 20px;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 20px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: #eff6ff;
        color: #1687f8;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 24px;
    }

    .empty-meetings h3 {
        margin: 0 0 7px;
        color: #0f172a;
        font-size: 18px;
    }

    .empty-meetings p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    @@media (max-width: 600px) {
        .meetings-page {
            padding: 20px 15px;
        }

        .meetings-header {
            align-items: flex-start;
            gap: 15px;
        }

        .meetings-header h1 {
            font-size: 24px;
        }

        .meetings-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="meetings-page">

    <div class="meetings-header" style="margin-top: 100px">
        <div>
            <h1>Meetings</h1>
            <p>Manage meetings scheduled by your clients.</p>
        </div>

        <div class="meeting-count">
            @Model.Count meeting@(Model.Count == 1 ? "" : "s")
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="meetings-grid">

            @foreach (var meeting in Model)
            {
                <div class="meeting-card">

                    <div class="meeting-top">

                        <div class="client-info">

                            <div class="client-avatar">
                                @(string.IsNullOrWhiteSpace(meeting.Name)
                                    ? "?"
                                    : meeting.Name.Substring(0, 1).ToUpper())
                            </div>

                            <div>
                                <div class="client-name">
                                    @meeting.Name
                                </div>

                                <div class="client-email">
                                    @meeting.Email
                                </div>
                            </div>

                        </div>

                        <div class="status">
                            CONFIRMED
                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(meeting.ProjectType))
                    {
                        <div class="project-type">
                            @meeting.ProjectType
                        </div>
                    }


                    <div class="meeting-info">

                        <div class="info-row">

                            <div class="info-icon">
                                <i class="fa-regular fa-calendar"></i>
                            </div>

                            <div class="info-content">

                                <span class="info-label">
                                    Meeting Date
                                </span>

                                <span class="info-value">
                                    @meeting.MeetingDate.ToString("dddd, MMMM d, yyyy")
                                </span>

                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-icon">
                                <i class="fa-regular fa-clock"></i>
                            </div>

                            <div class="info-content">

                                <span class="info-label">
                                    Time
                                </span>

                                <span class="info-value">
                                    @DateTime.Today.Add(meeting.StartTime).ToString("h:mm tt")
                                    —
                                    @DateTime.Today.Add(meeting.EndTime).ToString("h:mm tt")
                                </span>

                            </div>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(meeting.Message))
                    {
                        <div class="message-box">

                            <div class="message-title">
                                Client Message
                            </div>

                            <div class="message-text">
                                @meeting.Message
                            </div>

                        </div>
                    }


                    <div class="meeting-actions">

                        <a href="https://meet.google.com/"
                           target="_blank"
                           rel="noopener"
                           class="join-btn">

                            <i class="fa-solid fa-video"></i>

                            Join Google Meet

                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-meetings">

            <div class="empty-icon">
                <i class="fa-regular fa-calendar"></i>
            </div>

            <h3>No meetings yet</h3>

            <p>
                Meetings scheduled by clients will appear here.
            </p>

        </div>
    }

</div>