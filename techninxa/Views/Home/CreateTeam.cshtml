<style>

    * {
        box-sizing: border-box;
    }

    .create-team-page {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 50px 40px 80px;
    }


    /* =========================
       HEADER
       ========================= */

    .create-team-header {
        margin-bottom: 42px;
    }

    .header-content {
        max-width: 850px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #777;
        text-decoration: none;
        font-size: 14px;
        margin-bottom: 28px;
        transition: .25s ease;
    }

    .back-link:hover {
        color: #111;
