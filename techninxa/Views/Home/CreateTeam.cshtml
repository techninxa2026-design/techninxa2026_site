    .remove-image:hover {
        border-color: #222;
        color: #111;
    }


    /* =========================
       STATUS SWITCH
       ========================= */

    .status-group {
        min-width: 0;
    }

    .switch-wrapper {
        min-height: 52px;
        display: flex !important;
        align-items: center;
        gap: 13px !important;
        margin: 0 !important;
        cursor: pointer;
    }

    .switch-wrapper input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .switch {
        position: relative;
        flex: 0 0 auto;
        width: 46px;
        height: 25px;
        border-radius: 30px;
        background: #ccc;
        transition: .25s ease;
    }

    .switch::after {
        content: "";
        position: absolute;
        top: 4px;
        left: 4px;
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: #fff;
        transition: .25s ease;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
    }

    .switch-wrapper input:checked + .switch {
        background: #222;
    }

    .switch-wrapper input:checked + .switch::after {
