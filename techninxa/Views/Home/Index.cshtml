</section>



<!-- ==============================
     SCHEDULE
     ============================== -->

<section class="schedule-section">

    <div class="container">

        <div class="schedule-card reveal">

            <div class="schedule-content">

                <span class="schedule-kicker">
                    LET'S TALK
                </span>

                <h2>
                    Have an idea?
                    <em>Let's find a time.</em>
                </h2>

                <p>
                    Choose a convenient time to talk with us about your
                    project, idea, or business needs. Pick a time that
                    works for you and we'll take it from there.
                </p>

                <a href="/makeschedule" class="schedule-btn">

                    Make a Schedule

                    <span>↗</span>

                </a>

            </div>


            <div class="schedule-visual">

                <div class="schedule-glow"></div>

                <div class="schedule-clock">

                    <div class="clock-ring"></div>

                    <div class="clock-center">

                        <span>AVAILABLE</span>
                        <strong>TIME</strong>

                    </div>

                </div>


                <div class="schedule-floating schedule-floating-one">

                    <span>01</span>

                    <div>

                        <strong>Choose</strong>
                        <small>a time</small>

                    </div>

                </div>


                <div class="schedule-floating schedule-floating-two">

                    <span>02</span>

                    <div>

                        <strong>Meet</strong>
                        <small>with us</small>

                    </div>

                </div>

