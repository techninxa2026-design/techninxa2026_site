<!-- ==============================
     ABOUT TECHNINXA
     ============================== -->

<section class="section about-section" id="about">

    <div class="container">

        <!-- ABOUT INTRO -->

        <div class="about-grid">

            <!-- BRAND BLOCK -->

            <div class="about-mark reveal">

                <div class="about-logo">

                    <img src="~/assets/techninxa-logo.png"
                         alt="Techninxa">

                </div>

                <span>
                    INNOVATE. BUILD. ELEVATE.
                </span>

            </div>


            <!-- ABOUT CONTENT -->

            <div class="about-copy reveal">

                <span class="kicker">
                    ABOUT TECHNINXA
                </span>

                <h2>
                    We turn ideas into technology
                    <em>people can actually use.</em>
                </h2>

                <p>
                    Techninxa is a technology-focused company creating
                    practical digital solutions across web, mobile,
                    software and connected systems.
                </p>

                <p>
                    Our approach is simple: understand the problem,
                    choose the right tools, build with care and keep improving.
                </p>

                <a class="btn btn-dark" href="/Projects">

                    See our work

                    <span>↗</span>

                </a>

            </div>

        </div>



        <!-- ==============================
             MEET THE TEAM
             ============================== -->

        <div class="team-section">

            <!-- TEAM HEADER -->

            <div class="section-heading team-heading reveal">

                <div>

                    <span class="kicker">
                        THE PEOPLE BEHIND TECHNINXA
                    </span>

                    <h2>
                        Meet the <em>team.</em>
                    </h2>

                </div>

                <p>
                    A focused team combining engineering, product development,
                    business growth and security.
                </p>

            </div>


            <!-- TEAM GRID -->

            <div class="team-grid">

                @if (ViewBag.TeamMembers != null && ViewBag.TeamMembers.Count > 0)
                {
                    int teamIndex = 1;

                    foreach (var member in ViewBag.TeamMembers)
                    {
                        <article class="team-card reveal @(teamIndex % 2 == 0 ? "reveal-delay" : "")">

                            <div class="team-image">

                                @if (!string.IsNullOrWhiteSpace(member.Image))
                                {
                                    <img src="@member.Image"
                                         alt="@(string.IsNullOrWhiteSpace(member.AltText) ? member.Name : member.AltText)"
                                         loading="lazy">
                                }
                                else
                                {
                                    <div class="team-no-image">

                                        @member.Name

                                    </div>
                                }


                                <span class="team-number">

                                    @teamIndex.ToString("00")

                                </span>


                                <div class="team-overlay">

                                    <span>
                                        @member.Department
                                    </span>

                                </div>

                            </div>


                            <div class="team-info">

                                <div class="team-info-content">

                                    <span class="team-label">

                                        @member.Department

                                    </span>


                                    <h3>

                                        @member.Name

                                    </h3>


                                    <div class="team-role">

                                        @member.Role

                                    </div>

                                </div>


                                <a href="#"
                                   class="team-arrow"
                                   aria-label="View @member.Name">

                                    ↗

                                </a>

                            </div>

                        </article>

                        teamIndex++;
                    }
                }
                else
                {
                    <div class="no-team-members">

                        <p>
                            Our team information will be available soon.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</section>



<!-- ==============================
     CONTACT
     ============================== -->

<section class="contact-section" id="contact">

    <div class="container contact-box reveal">

        <div class="contact-copy">

            <span class="kicker">
                HAVE AN IDEA?
            </span>

            <h2>
                Let's build something <em>useful.</em>
            </h2>

            <p>
                Tell us what you want to create. We'll turn the first
                conversation into a clear next step.
            </p>


            <div class="contact-details">

                <a href="mailto:contact@@techninxa.com">
                    support@@techninxa.com
                </a>

                <a href="tel:+8801790379729">
                    01790-379729
                </a>

                <a href="tel:+8801747414675">
                    01747-414675
                </a>

                <span>
                    Bangladesh
                </span>

            </div>

        </div>


        <form class="contact-form"
              method="post"
              asp-action="SubmitMessege"
              asp-controller="Home">

            <label>

                Name

                <input type="text"
                       asp-for="Name"
                       placeholder="Your name"
                       required>

            </label>


            <label>

                Email

                <input type="email"
                       asp-for="Email"
                       placeholder="you@example.com"
                       required>

            </label>


            <label>

                Project type

                <select asp-for="ProjectType" required>

                    <option value="WebDevelopment">
                        Web Development
                    </option>

                    <option value="MobileApp">
                        Mobile App
                    </option>

                    <option value="CustomSoftware">
                        Custom Software
                    </option>

                    <option value="IoTEmbedded">
                        IoT / Embedded
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>

            </label>


            <label>

                Tell us about it

                <textarea asp-for="Message"
                          rows="4"
                          placeholder="A short description of your idea..."
                          required></textarea>

            </label>


            <button class="btn btn-primary" type="submit">

                Send Message <span>↗</span>

            </button>


            @if (TempData["SuccessMessage"] != null)
            {
                <p>
                    @TempData["SuccessMessage"]
                </p>
            }


            <p class="form-note" id="formNote"></p>

        </form>

    </div>

</section>

