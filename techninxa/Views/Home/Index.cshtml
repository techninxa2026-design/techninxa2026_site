<!-- ==============================
     PROJECTS
     ============================== -->

<section class="section projects-feature" id="projects">

    <div class="container">

        <div class="section-heading reveal">

            <div>

                <span class="kicker">
                    SELECTED WORK
                </span>

                <h2>
                    Things we've built.
                </h2>

            </div>

            <a class="text-link" href="/Projects">
                View all projects <span>↗</span>
            </a>

        </div>


        <div class="project-showcase">

            @if (ViewBag.Projects != null && ViewBag.Projects.Count > 0)
            {
                int projectIndex = 1;

                foreach (var project in ViewBag.Projects)
                {
                    <a class="project-feature-card @(projectIndex % 2 == 1 ? "project-dark" : "project-light") reveal"
                       href="/Projects/Details/@project.Slug">

                        <div class="project-image">

                            @if (!string.IsNullOrEmpty(project.HeroImage))
                            {
                                <img src="@project.HeroImage"
                                     alt="@project.Title"
                                     style="width:100%; height:100%; object-fit:cover;">
                            }
                            else
                            {
                                <div class="project-no-image">

                                    <span>
                                        @project.Title
                                    </span>

                                </div>
                            }

                            <span class="project-badge @(projectIndex % 2 == 1 ? "" : "dark")">
                                @project.Category
                            </span>

                        </div>


                        <div class="project-info">

                            <div>

                                <span class="project-index">
                                    @projectIndex.ToString("00")
                                </span>

                                <h3>
                                    @project.Title
                                </h3>

                            </div>

                            <p>
                                @project.ShortDescription
                            </p>

                            <span class="arrow-link">
                                View project ↗
                            </span>

                        </div>

                    </a>

                    projectIndex++;
                }
            }
            else
            {
                <div class="no-projects">

                    <p>
                        No projects available yet.
                    </p>

                </div>
            }

        </div>

    </div>

</section>



