@model techninxa.Models.TeamMember

@{
ViewData["Title"] = "Edit Team Member";
ViewData["ActiveNav"] = "Team";
}

<div class="edit-team-page">


<!-- PAGE HEADER -->
<div class="edit-team-header">

    <div class="header-content">

        <a href="/Team" class="back-link">
            ← Back to Team
        </a>

        <span class="admin-kicker">TEAM MANAGEMENT</span>

        <h1>Edit <em>Team Member.</em></h1>

        <p>
            Update the team member's information, profile image,
            display order, or visibility.
        </p>

    </div>

</div>


<!-- MAIN LAYOUT -->
<div class="edit-team-layout">

    <!-- FORM CARD -->
    <div class="edit-team-card">

        <div class="card-top">

            <div>
                <span class="card-kicker">EDIT MEMBER</span>
                <h2>@Model.Name</h2>
            </div>

            <div class="member-id">
                #@Model.Id.ToString("00")
            </div>

        </div>


        <form method="post"
              action="/Team/Edit/@Model.Id"
              enctype="multipart/form-data"
              class="team-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />


            <!-- VALIDATION -->
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- NAME -->
            <div class="form-group">

                <label asp-for="Name">
                    Full Name
                    <span>*</span>
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="e.g. Ashik Rahman"
                       autocomplete="off" />

                <span asp-validation-for="Name"
                      class="field-validation">
                </span>

            </div>


            <!-- DEPARTMENT + ROLE -->
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Department">
                        Department
                        <span>*</span>
                    </label>

                    <input asp-for="Department"
                           class="form-control"
                           placeholder="e.g. Management" />

                    <span asp-validation-for="Department"
                          class="field-validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Role">
                        Role / Position
                        <span>*</span>
                    </label>

                    <input asp-for="Role"
                           class="form-control"
                           placeholder="e.g. CEO & Founder" />

                    <span asp-validation-for="Role"
                          class="field-validation">
                    </span>

                </div>

            </div>


            <!-- ALT TEXT -->
            <div class="form-group">

                <label asp-for="AltText">
                    Image Alt Text
                    <span class="optional">Optional</span>
                </label>

                <input asp-for="AltText"
                       class="form-control"
                       placeholder="e.g. Ashik Rahman - CEO of Techninxa" />

                <div class="field-help">
                    Used for accessibility and search engines.
                </div>

                <span asp-validation-for="AltText"
                      class="field-validation">
                </span>

            </div>


            <!-- IMAGE -->
            <div class="form-group">

                <label for="ImageFile">
                    Profile Image
                    <span class="optional">Optional</span>
                </label>


                <div class="image-upload-area" id="imageUploadArea">

                    <input type="file"
                           id="ImageFile"
                           name="ImageFile"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="image-file-input" />


                    <!-- CURRENT IMAGE -->
                    <div class="current-image-area"
                         id="currentImageArea">

                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <img src="@Model.Image"
                                 id="previewImage"
                                 alt="@(string.IsNullOrWhiteSpace(Model.AltText) ? Model.Name : Model.AltText)" />

                            <div class="current-image-info">

                                <strong>
                                    Current profile image
                                </strong>

                                <span>
                                    Upload a new image to replace it.
                                </span>

                                <button type="button"
                                        id="changeImage"
                                        class="change-image-btn">
                                    Change Image
                                </button>

                            </div>
                        }
                        else
                        {
                            <div class="no-current-image"
                                 id="noCurrentImage">

                                <div class="no-image-icon">
                                    +
                                </div>

                                <strong>No profile image</strong>

                                <span>
                                    Click here to upload one.
                                </span>

                            </div>
                        }

                    </div>


                    <!-- NEW IMAGE PREVIEW -->
                    <div class="new-image-preview"
                         id="newImagePreview">

                        <img id="newPreviewImage"
                             src=""
                             alt="New image preview">

                        <div class="new-image-details">

                            <strong id="newFileName">
                                New image
                            </strong>

                            <span id="newFileSize">
                            </span>

                            <button type="button"
                                    id="removeNewImage"
                                    class="remove-image">
                                Cancel New Image
                            </button>

                        </div>

                    </div>

                </div>


                <div class="field-help">
                    JPG, PNG or WEBP · Maximum 5 MB.
                    Leave empty to keep the current image.
                </div>

                <span class="field-validation"
                      id="imageError">
                </span>

            </div>


            <!-- ORDER + STATUS -->
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="DisplayOrder">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="form-control" />

                    <div class="field-help">
                        Lower numbers appear first.
                    </div>

                    <span asp-validation-for="DisplayOrder"
                          class="field-validation">
                    </span>

                </div>


                <div class="form-group status-group">

                    <label>
                        Visibility
                    </label>

                    <label class="switch-wrapper">

                        <input asp-for="IsActive"
                               type="checkbox" />

                        <span class="switch"></span>

                        <span class="switch-text">

                            <strong>
                                @(Model.IsActive ? "Active" : "Inactive")
                            </strong>

                            <small>
                                @(Model.IsActive
                                    ? "Visible on the homepage"
                                    : "Hidden from the homepage")
                            </small>

                        </span>

                    </label>

                </div>

            </div>


            <!-- BUTTONS -->
            <div class="form-actions">

                <a href="/Team"
                   class="cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="save-btn">
                    ✓
                    Save Changes
                </button>

            </div>

        </form>

    </div>


    <!-- RIGHT SIDE -->
    <aside class="edit-preview-card">

        <span class="card-kicker">
            CURRENT MEMBER
        </span>

        <h2>Preview.</h2>


        <!-- TEAM CARD PREVIEW -->
        <div class="team-preview-card">

            <div class="preview-photo"
                 id="sidePreview">

                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {
                    <img src="@Model.Image"
                         id="sidePreviewImage"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="preview-placeholder"
                         id="sidePlaceholder">

                        <span>
                            +
                        </span>

                        <small>
                            No photo
                        </small>

                    </div>
                }

                <div class="preview-number">
                    @Model.DisplayOrder.ToString("00")
                </div>

            </div>


            <div class="preview-info">

                <span id="previewDepartment">
                    @Model.Department
                </span>

                <h3 id="previewName">
                    @Model.Name
                </h3>

                <div id="previewRole">
                    @Model.Role
                </div>

                <span class="preview-arrow">
                    ↗
                </span>

            </div>

        </div>


        <!-- STATUS -->
        <div class="member-status-box">

            <div class="status-dot @(Model.IsActive ? "active" : "inactive")">
            </div>

            <div>

                <strong id="statusTitle">
                    @(Model.IsActive ? "Currently Active" : "Currently Inactive")
                </strong>

                <p id="statusDescription">
                    @(Model.IsActive
                        ? "This member is visible on your homepage."
                        : "This member is hidden from your homepage.")
                </p>

            </div>

        </div>


        <!-- INFO -->
        <div class="edit-note">

            <div class="note-icon">
                i
            </div>

            <div>

                <strong>Image replacement</strong>

                <p>
                    If you upload a new image, the old image
                    will automatically be removed from the server.
                </p>

            </div>

        </div>

    </aside>

</div>
```

</div>

<style>

    * {
        box-sizing: border-box;
    }


    .edit-team-page {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 50px 40px 80px;
    }


    /* =========================
       HEADER
       ========================= */

    .edit-team-header {
        margin-bottom: 42px;
    }

    .header-content {
        max-width: 850px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #777;
        text-decoration: none;
        font-size: 14px;
        margin-bottom: 28px;
        transition: .25s ease;
    }

    .back-link:hover {
        color: #111;
        transform: translateX(-3px);
    }

    .admin-kicker,
    .card-kicker {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2.5px;
        color: #888;
        margin-bottom: 12px;
    }

    .edit-team-header h1 {
        margin: 0;
        font-size: clamp(42px, 5vw, 72px);
        line-height: .95;
        letter-spacing: -3px;
        font-weight: 500;
        color: #111;
    }

    .edit-team-header h1 em {
        font-style: normal;
        font-weight: 400;
        color: #888;
    }

    .edit-team-header p {
        margin: 20px 0 0;
        max-width: 680px;
        color: #777;
        font-size: 16px;
        line-height: 1.7;
    }


    /* =========================
       LAYOUT
       ========================= */

    .edit-team-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(320px, .8fr);
        gap: 28px;
        align-items: start;
    }


    /* =========================
       FORM CARD
       ========================= */

    .edit-team-card {
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 12px 40px rgba(0,0,0,.04);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-bottom: 28px;
        margin-bottom: 30px;
        border-bottom: 1px solid #ededed;
    }

    .card-top h2,
    .edit-preview-card h2 {
        margin: 0;
        font-size: 27px;
        font-weight: 500;
        letter-spacing: -1px;
        color: #111;
    }

    .member-id {
        min-width: 48px;
        height: 48px;
        padding: 0 12px;
        border: 1px solid #ddd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #777;
    }


    /* =========================
       FORM
       ========================= */

    .team-form {
        width: 100%;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #222;
        font-size: 13px;
        font-weight: 650;
    }

    .form-group label > span:not(.optional) {
        color: #999;
    }

    .form-group label .optional {
        margin-left: 5px;
        font-size: 10px;
        font-weight: 500;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .form-control {
        width: 100%;
        height: 52px;
        padding: 0 16px;
        border: 1px solid #ddd;
        border-radius: 9px;
        background: #fafafa;
        color: #111;
        font-size: 14px;
        outline: none;
        transition: .25s ease;
        font-family: inherit;
    }

    .form-control:hover {
        border-color: #c9c9c9;
    }

    .form-control:focus {
        border-color: #222;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(0,0,0,.04);
    }

    .form-control::placeholder {
        color: #aaa;
    }

    .field-help {
        margin-top: 7px;
        font-size: 11px;
        line-height: 1.5;
        color: #999;
    }

    .field-validation,
    .validation-summary {
        color: #c0392b;
        font-size: 12px;
    }

    .validation-summary {
        margin-bottom: 20px;
    }

    .validation-summary ul {
        margin: 0;
        padding-left: 18px;
    }


    /* =========================
       IMAGE AREA
       ========================= */

    .image-upload-area {
        position: relative;
        min-height: 190px;
        border: 1px dashed #ccc;
        border-radius: 12px;
        background: #fafafa;
        overflow: hidden;
        transition: .25s ease;
    }

    .image-upload-area:hover {
        border-color: #222;
    }

    .image-file-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .current-image-area {
        min-height: 190px;
        display: flex;
        align-items: center;
        gap: 22px;
        padding: 20px;
    }

    .current-image-area img {
        width: 145px;
        height: 145px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #ddd;
        flex-shrink: 0;
    }

    .current-image-info {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .current-image-info strong {
        color: #222;
        font-size: 13px;
    }

    .current-image-info span {
        color: #999;
        font-size: 11px;
    }

    .change-image-btn {
        position: relative;
        z-index: 20;
        align-self: flex-start;
        margin-top: 8px;
        padding: 8px 13px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: #fff;
        color: #555;
        cursor: pointer;
        font-family: inherit;
        font-size: 11px;
    }

    .change-image-btn:hover {
        border-color: #222;
        color: #111;
    }

    .no-current-image {
        width: 100%;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
    }

    .no-image-icon {
        width: 48px;
        height: 48px;
        margin-bottom: 10px;
        border: 1px solid #ddd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 23px;
    }

    .no-current-image strong {
        font-size: 13px;
        color: #555;
    }

    .no-current-image span {
        margin-top: 5px;
        color: #aaa;
        font-size: 11px;
    }


    /* =========================
       NEW IMAGE
       ========================= */

    .new-image-preview {
        display: none;
        min-height: 190px;
        align-items: center;
        gap: 22px;
        padding: 20px;
        background: #fff;
    }

    .new-image-preview.show {
        display: flex;
    }

    .new-image-preview img {
        width: 145px;
        height: 145px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #ddd;
        flex-shrink: 0;
    }

    .new-image-details {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .new-image-details strong {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #222;
        font-size: 13px;
    }

    .new-image-details span {
        color: #999;
        font-size: 11px;
    }

    .remove-image {
        position: relative;
        z-index: 20;
        align-self: flex-start;
        margin-top: 8px;
        padding: 7px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: #fff;
        color: #777;
        cursor: pointer;
        font-size: 11px;
    }

    .remove-image:hover {
        border-color: #222;
        color: #111;
    }


    /* =========================
       STATUS SWITCH
       ========================= */

    .status-group {
        min-width: 0;
    }

    .switch-wrapper {
        min-height: 52px;
        display: flex !important;
        align-items: center;
        gap: 13px !important;
        margin: 0 !important;
        cursor: pointer;
    }

    .switch-wrapper input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .switch {
        position: relative;
        flex: 0 0 auto;
        width: 46px;
        height: 25px;
        border-radius: 30px;
        background: #ccc;
        transition: .25s ease;
    }

    .switch::after {
        content: "";
        position: absolute;
        top: 4px;
        left: 4px;
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: #fff;
        transition: .25s ease;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
    }

    .switch-wrapper input:checked + .switch {
        background: #222;
    }

    .switch-wrapper input:checked + .switch::after {
        transform: translateX(21px);
    }

    .switch-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .switch-text strong {
        font-size: 13px;
        font-weight: 600;
        color: #222;
    }

    .switch-text small {
        font-size: 11px;
        font-weight: 400;
        color: #999;
    }


    /* =========================
       FORM ACTIONS
       ========================= */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 10px;
        margin-top: 10px;
        border-top: 1px solid #ededed;
    }

    .cancel-btn,
    .save-btn {
        height: 48px;
        padding: 0 21px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: .25s ease;
        font-family: inherit;
    }

    .cancel-btn {
        border: 1px solid #ddd;
        color: #666;
        background: #fff;
    }

    .cancel-btn:hover {
        border-color: #222;
        color: #111;
    }

    .save-btn {
        border: 1px solid #111;
        background: #111;
        color: #fff;
    }

    .save-btn:hover {
        background: #333;
        transform: translateY(-1px);
    }


    /* =========================
       RIGHT PREVIEW
       ========================= */

    .edit-preview-card {
        position: sticky;
        top: 25px;
        background: #f7f7f7;
        border: 1px solid #e6e6e6;
        border-radius: 18px;
        padding: 30px;
    }

    .edit-preview-card h2 {
        margin-bottom: 25px;
    }

    .team-preview-card {
        background: #fff;
        border-radius: 13px;
        overflow: hidden;
        border: 1px solid #e5e5e5;
    }

    .preview-photo {
        position: relative;
        height: 280px;
        background: #e9e9e9;
        overflow: hidden;
    }

    .preview-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .preview-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #aaa;
    }

    .preview-placeholder span {
        font-size: 42px;
        font-weight: 200;
        line-height: 1;
    }

    .preview-placeholder small {
        margin-top: 8px;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .preview-number {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,.9);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #555;
    }

    .preview-info {
        position: relative;
        padding: 22px;
    }

    .preview-info > span:first-child {
        display: block;
        font-size: 9px;
        letter-spacing: 1.8px;
        color: #999;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .preview-info h3 {
        margin: 0;
        font-size: 22px;
        line-height: 1.1;
        font-weight: 500;
        color: #111;
    }

    .preview-info > div {
        margin-top: 7px;
        color: #777;
        font-size: 12px;
    }

    .preview-arrow {
        position: absolute;
        right: 20px;
        bottom: 20px;
        font-size: 20px !important;
        color: #999 !important;
    }


    /* =========================
       STATUS BOX
       ========================= */

    .member-status-box {
        display: flex;
        gap: 13px;
        margin-top: 20px;
        padding: 17px;
        background: #fff;
        border: 1px solid #e4e4e4;
        border-radius: 10px;
    }

    .status-dot {
        flex: 0 0 auto;
        width: 10px;
        height: 10px;
        margin-top: 4px;
        border-radius: 50%;
        background: #aaa;
    }

    .status-dot.active {
        background: #222;
    }

    .status-dot.inactive {
        background: #bbb;
    }

    .member-status-box strong {
        display: block;
        font-size: 12px;
        color: #222;
        margin-bottom: 4px;
    }

    .member-status-box p {
        margin: 0;
        color: #888;
        font-size: 11px;
        line-height: 1.5;
    }


    /* =========================
       NOTE
       ========================= */

    .edit-note {
        display: flex;
        gap: 13px;
        margin-top: 14px;
        padding: 18px;
        border: 1px solid #e4e4e4;
        border-radius: 10px;
        background: #fff;
    }

    .note-icon {
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #555;
        font-weight: 600;
    }

    .edit-note strong {
        display: block;
        font-size: 12px;
        color: #222;
        margin-bottom: 4px;
    }

    .edit-note p {
        margin: 0;
        color: #888;
        font-size: 11px;
        line-height: 1.6;
    }


    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 1050px) {

        .edit-team-layout {
            grid-template-columns: 1fr;
        }

        .edit-preview-card {
            position: static;
        }

    }


    @@media (max-width: 700px) {

        .edit-team-page {
            padding: 30px 18px 60px;
        }

        .edit-team-header h1 {
            font-size: 45px;
            letter-spacing: -2px;
        }

        .edit-team-card {
            padding: 23px;
            border-radius: 14px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

