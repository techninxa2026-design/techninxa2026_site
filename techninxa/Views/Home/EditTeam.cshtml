<partial name="_ValidationScriptsPartial" />

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const fileInput =
            document.getElementById("ImageFile");

        const imageUploadArea =
            document.getElementById("imageUploadArea");

        const currentImageArea =
            document.getElementById("currentImageArea");

        const newImagePreview =
            document.getElementById("newImagePreview");

        const newPreviewImage =
            document.getElementById("newPreviewImage");

        const newFileName =
            document.getElementById("newFileName");

        const newFileSize =
            document.getElementById("newFileSize");

        const removeNewImage =
            document.getElementById("removeNewImage");

        const imageError =
            document.getElementById("imageError");

        const nameInput =
            document.getElementById("Name");

        const departmentInput =
            document.getElementById("Department");

        const roleInput =
            document.getElementById("Role");

        const displayOrderInput =
            document.getElementById("DisplayOrder");

        const previewName =
            document.getElementById("previewName");

        const previewDepartment =
            document.getElementById("previewDepartment");

        const previewRole =
            document.getElementById("previewRole");

        const sidePreview =
            document.getElementById("sidePreview");

        const statusInput =
            document.getElementById("IsActive");

        const statusTitle =
            document.getElementById("statusTitle");

        const statusDescription =
            document.getElementById("statusDescription");

        const statusDot =
            document.querySelector(".status-dot");


        /* =========================
           CHANGE IMAGE
           ========================= */

        const changeImage =
            document.getElementById("changeImage");

        if (changeImage) {

            changeImage.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    fileInput.click();

                }
            );

        }


        /* =========================
           FILE UPLOAD
           ========================= */

        if (fileInput) {

            fileInput.addEventListener(
                "change",
                function () {

                    imageError.textContent = "";

                    if (!fileInput.files ||
                        fileInput.files.length === 0) {
                        return;
                    }

                    const file =
                        fileInput.files[0];

                    const allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];

                    if (!allowedTypes.includes(file.type)) {

                        imageError.textContent =
                            "Only JPG, PNG and WEBP images are allowed.";

                        fileInput.value = "";

                        return;
                    }

                    if (file.size > 5 * 1024 * 1024) {

                        imageError.textContent =
                            "Image cannot be larger than 5 MB.";

                        fileInput.value = "";

                        return;
                    }


                    const reader =
                        new FileReader();

                    reader.onload =
                        function (event) {

                            newPreviewImage.src =
                                event.target.result;

                            newImagePreview
                                .classList
                                .add("show");

                            currentImageArea.style.display =
                                "none";

                            newFileName.textContent =
                                file.name;

                            const sizeMb =
                                (file.size /
                                (1024 * 1024))
                                .toFixed(2);

                            newFileSize.textContent =
                                sizeMb + " MB";


                            /* Update homepage preview */

                            sidePreview.innerHTML =
                                '<img src="' +
                                event.target.result +
                                '" alt="Team member preview">' +
                                '<div class="preview-number">' +
                                getDisplayNumber() +
                                '</div>';

                        };

                    reader.readAsDataURL(file);

                }
            );


            /* =========================
               REMOVE NEW IMAGE
               ========================= */

            removeNewImage.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    fileInput.value = "";

                    newImagePreview
                        .classList
                        .remove("show");

                    currentImageArea.style.display =
                        "flex";

                    imageError.textContent = "";

                    restoreSidePreview();

                }
            );


            /* =========================
               DRAG & DROP
               ========================= */

            imageUploadArea.addEventListener(
                "dragover",
                function (event) {

                    event.preventDefault();

                    imageUploadArea.style.borderColor =
                        "#222";

                }
            );

            imageUploadArea.addEventListener(
                "dragleave",
                function () {

                    imageUploadArea.style.borderColor =
                        "#ccc";

                }
            );

            imageUploadArea.addEventListener(
                "drop",
                function (event) {

                    event.preventDefault();

                    imageUploadArea.style.borderColor =
                        "#ccc";

                    if (event.dataTransfer.files.length > 0) {

                        try {

                            fileInput.files =
                                event.dataTransfer.files;

                            fileInput.dispatchEvent(
                                new Event("change")
                            );

                        } catch (error) {

                            console.log(error);

                        }

                    }

                }
            );

        }


        /* =========================
           TEXT PREVIEW
           ========================= */

        function updatePreview(
            input,
            target,
            fallback) {

            if (!input || !target) {
                return;
            }

            input.addEventListener(
                "input",
                function () {

                    const value =
                        input.value.trim();

                    target.textContent =
                        value || fallback;

                }
            );

        }


        updatePreview(
            nameInput,
            previewName,
            "Your Name"
        );

        updatePreview(
            departmentInput,
            previewDepartment,
            "DEPARTMENT"
        );

        updatePreview(
            roleInput,
            previewRole,
            "Your Role"
        );


        /* =========================
           DISPLAY ORDER PREVIEW
           ========================= */

        function getDisplayNumber() {

            if (!displayOrderInput) {
                return "01";
            }

            let value =
                parseInt(displayOrderInput.value);

            if (isNaN(value)) {
                value = 0;
            }

            return String(value).padStart(2, "0");
        }


        if (displayOrderInput) {

            displayOrderInput.addEventListener(
                "input",
                function () {

                    const number =
                        getDisplayNumber();

                    const numberElement =
                        document.querySelector(
                            ".preview-number"
                        );

                    if (numberElement) {
                        numberElement.textContent =
                            number;
                    }

                }
            );

        }


        /* =========================
           STATUS PREVIEW
           ========================= */

        if (statusInput) {

            statusInput.addEventListener(
                "change",
                function () {

                    if (statusInput.checked) {

                        statusTitle.textContent =
                            "Currently Active";

                        statusDescription.textContent =
                            "This member is visible on your homepage.";

                        statusDot.classList
                            .remove("inactive");

                        statusDot.classList
                            .add("active");

                    }
                    else {

                        statusTitle.textContent =
                            "Currently Inactive";

                        statusDescription.textContent =
                            "This member is hidden from your homepage.";

                        statusDot.classList
                            .remove("active");

                        statusDot.classList
                            .add("inactive");

                    }

                }
            );

        }


        /* =========================
           RESTORE ORIGINAL IMAGE
           ========================= */

        function restoreSidePreview() {

            const originalImage =
                "@Html.Raw(
                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                        Model.Image ?? ""
                    )
                )";

            const originalName =
                "@Html.Raw(
                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                        Model.Name ?? ""
                    )
                )";

            if (originalImage) {

                sidePreview.innerHTML =
                    '<img src="' +
                    originalImage +
                    '" alt="' +
                    originalName +
                    '">' +
                    '<div class="preview-number">' +
                    getDisplayNumber() +
                    '</div>';

            }
            else {

                sidePreview.innerHTML =
                    '<div class="preview-placeholder">' +
                    '<span>+</span>' +
                    '<small>No photo</small>' +
                    '</div>' +
                    '<div class="preview-number">' +
                    getDisplayNumber() +
                    '</div>';

            }

        }

    });

</script>


