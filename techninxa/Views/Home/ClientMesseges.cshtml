@using Techninxa.Models
@model IEnumerable<Techninxa.Models.ContactMessage>

@{
    ViewData["Title"] = "Client Messages";

    var totalMessages = Model?.Count() ?? 0;
}

<style>
    /* =========================================
       PAGE
    ========================================= */

    .messages-page {
        margin-top: 80px;
        min-height: 100vh;
        background: #070a10;
        color: #ffffff;
        padding: 40px;
    }

    .messages-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }


    /* =========================================
       HEADER
    ========================================= */

    .messages-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
    }

    .messages-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .messages-icon {
        width: 54px;
        height: 54px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 16px;

        background: rgba(22, 135, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);

        color: #38bdf8;
        font-size: 22px;
    }

    .messages-header h1 {
        margin: 0;

        color: #ffffff;

        font-size: 30px;
        font-weight: 700;

        letter-spacing: -0.5px;
    }

    .messages-header p {
        margin: 6px 0 0;

        color: #8994a5;

        font-size: 14px;
    }

    .message-count {
        padding: 9px 16px;

        border-radius: 30px;

        background: rgba(56, 189, 248, 0.10);
        border: 1px solid rgba(56, 189, 248, 0.20);

        color: #38bdf8;

        font-size: 13px;
        font-weight: 600;

        white-space: nowrap;
    }


    /* =========================================
       MESSAGE LIST
    ========================================= */

    .messages-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }


    /* =========================================
       MESSAGE CARD
    ========================================= */

    .message-card {
        background: #0d121b;

        border: 1px solid rgba(255, 255, 255, 0.07);

        border-radius: 18px;

        overflow: hidden;

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .message-card:hover {
        transform: translateY(-2px);

        border-color: rgba(56, 189, 248, 0.25);

        box-shadow:
            0 15px 40px rgba(0, 0, 0, 0.25);
    }


    /* =========================================
       CLIENT HEADER
    ========================================= */

    .message-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;

        gap: 20px;

        padding: 22px 25px;

        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .client-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .client-avatar {
        width: 48px;
        height: 48px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background:
            linear-gradient(
                135deg,
                rgba(22, 135, 248, 0.25),
                rgba(56, 189, 248, 0.08)
            );

        border: 1px solid rgba(56, 189, 248, 0.20);

        color: #38bdf8;

        font-size: 18px;
        font-weight: 700;
    }

    .client-name {
        margin: 0;

        color: #ffffff;

        font-size: 16px;
        font-weight: 650;
    }

    .client-email {
        margin-top: 5px;

        color: #7f8a9b;

        font-size: 13px;
    }

    .message-date {
        color: #778292;

        font-size: 12px;

        text-align: right;

        white-space: nowrap;
    }


    /* =========================================
       MESSAGE BODY
    ========================================= */

    .message-details {
        display: grid;

        grid-template-columns: 200px minmax(0, 1fr);

        gap: 30px;

        padding: 24px 25px;
    }

    .detail-label {
        margin-bottom: 9px;

        color: #6f7a8a;

        font-size: 11px;
        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: 0.8px;
    }


    /* =========================================
       PROJECT TYPE
    ========================================= */

    .project-type {
        display: inline-flex;

        align-items: center;

        padding: 8px 13px;

        border-radius: 9px;

        background: rgba(22, 135, 248, 0.10);

        border: 1px solid rgba(22, 135, 248, 0.20);

        color: #55bfff;

        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================
       MESSAGE TEXT
    ========================================= */

    .message-content {
        padding: 15px 17px;

        border-radius: 12px;

        background: rgba(255, 255, 255, 0.015);

        border: 1px solid rgba(255, 255, 255, 0.05);

        color: #c8d0dc;

        font-size: 14px;

        line-height: 1.8;

        white-space: pre-wrap;

        word-break: break-word;
    }


    /* =========================================
       EMPTY STATE
    ========================================= */

    .empty-messages {
        padding: 80px 30px;

        text-align: center;

        background: #0d121b;

        border: 1px solid rgba(255, 255, 255, 0.07);

        border-radius: 18px;
    }

    .empty-icon {
        width: 65px;
        height: 65px;

        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 18px;

        background: rgba(56, 189, 248, 0.08);

        color: #38bdf8;

        font-size: 27px;
    }

    .empty-messages h3 {
        margin: 0 0 8px;

        color: #ffffff;

        font-size: 18px;
    }

    .empty-messages p {
        margin: 0;

        color: #737e8e;

        font-size: 14px;
    }


    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 768px) {

        .messages-page {
            padding: 25px 15px;
        }

        .messages-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .messages-header h1 {
            font-size: 25px;
        }

        .message-top {
            flex-direction: column;
        }

        .message-date {
            text-align: left;
        }

        .message-details {
            grid-template-columns: 1fr;

            gap: 20px;
        }
    }


    @@media (max-width: 480px) {

        .messages-header-left {
            align-items: flex-start;
        }

        .messages-icon {
            width: 46px;
            height: 46px;

            font-size: 19px;
        }

        .messages-header h1 {
            font-size: 22px;
        }

        .message-top {
            padding: 18px;
        }

        .message-details {
            padding: 20px 18px;
        }

        .client-name {
            font-size: 15px;
        }

        .client-email {
            font-size: 12px;
        }
    }
</style>


<div class="messages-page">

    <div class="messages-container">


        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="messages-header">

            <div class="messages-header-left">

                <div class="messages-icon">
                    <i class="bi bi-chat-left-text"></i>
                </div>

                <div>

                    <h1>
                        Client Messages
                    </h1>

                    <p>
                        Messages and project inquiries received from your clients.
                    </p>

                </div>

            </div>


            <div class="message-count">

                @totalMessages

                Message@(totalMessages == 1 ? "" : "s")

            </div>

        </div>



        <!-- =========================================
             MESSAGES
        ========================================== -->

        @if (Model != null && Model.Any())
        {
            <div class="messages-list">

                @foreach (var message in Model.OrderByDescending(x => x.CreatedAt))
                {
                    /*
                     * =====================================
                     * PROJECT TYPE
                     * =====================================
                     *
                     * Your enum:
                     *
                     * 0 = WebDevelopment
                     * 1 = MobileApp
                     * 2 = CustomSoftware
                     * 3 = IoTEmbedded
                     * 4 = Other
                     *
                     */

                    var projectType = message.ProjectType switch
                    {
                        ProjectType.WebDevelopment => "Web Development",

                        ProjectType.MobileApp => "Mobile App",

                        ProjectType.CustomSoftware => "Custom Software",

                        ProjectType.IoTEmbedded => "IoT & Embedded",

                        ProjectType.Other => "Other",

                        _ => "Unknown"
                    };


                    /*
                     * =====================================
                     * CLIENT INITIAL
                     * =====================================
                     */

                    var clientInitial = "?";

                    if (!string.IsNullOrWhiteSpace(message.Name))
                    {
                        clientInitial = message.Name
                            .Trim()
                            .Substring(0, 1)
                            .ToUpper();
                    }


                    <!-- =================================
                         MESSAGE CARD
                    ================================== -->

                    <div class="message-card">


                        <!-- CLIENT INFORMATION -->

                        <div class="message-top">

                            <div class="client-info">

                                <div class="client-avatar">
                                    @clientInitial
                                </div>


                                <div>

                                    <h3 class="client-name">
                                        @message.Name
                                    </h3>

                                    <div class="client-email">
                                        @message.Email
                                    </div>

                                </div>

                            </div>


                            <div class="message-date">

                                @message.CreatedAt.ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")

                            </div>

                        </div>



                        <!-- MESSAGE INFORMATION -->

                        <div class="message-details">


                            <!-- PROJECT TYPE -->

                            <div>

                                <div class="detail-label">
                                    Project Type
                                </div>

                                <div class="project-type">

                                    @projectType

                                </div>

                            </div>



                            <!-- MESSAGE -->

                            <div>

                                <div class="detail-label">
                                    Message
                                </div>

                                <div class="message-content">

                                    @if (string.IsNullOrWhiteSpace(message.Message))
                                    {
                                        <span style="color:#687386;">
                                            No message provided.
                                        </span>
                                    }
                                    else
                                    {
                                        @message.Message
                                    }

                                </div>

                            </div>


                        </div>

                    </div>
                }

            </div>
        }
        else
        {

            <!-- =========================================
                 EMPTY STATE
            ========================================== -->

            <div class="empty-messages">

                <div class="empty-icon">
                    <i class="bi bi-chat-left"></i>
                </div>

                <h3>
                    No Client Messages
                </h3>

                <p>
                    You haven't received any client messages yet.
                </p>

            </div>

        }

    </div>

</div>
