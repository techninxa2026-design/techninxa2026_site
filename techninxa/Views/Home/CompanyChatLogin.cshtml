
@model Techninxa.Models.CompanyChatLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Techninxa Company Chat</title>

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --blue: #1687f8;
            --sky: #38bdf8;
            --deep: #070a10;
            --card: rgba(15, 21, 31, .82);
            --border: rgba(255,255,255,.09);
            --muted: #8b97a8;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 30px 18px;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(22,135,248,.16),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 90% 85%,
                    rgba(56,189,248,.09),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 50% -10%,
                    rgba(22,135,248,.08),
                    transparent 35%
                ),
                #070a10;

            color: #fff;

            font-family:
                Inter,
                Arial,
                sans-serif;

            position: relative;
            overflow: hidden;
        }

        /* BACKGROUND GLOW */

        body::before {
            content: "";

            position: fixed;

            width: 420px;
            height: 420px;

            left: -220px;
            bottom: -220px;

            background: rgba(22,135,248,.10);

            filter: blur(80px);

            border-radius: 50%;

            pointer-events: none;
        }

        body::after {
            content: "";

            position: fixed;

            width: 300px;
            height: 300px;

            right: -160px;
            top: -150px;

            background: rgba(56,189,248,.08);

            filter: blur(70px);

            border-radius: 50%;

            pointer-events: none;
        }

        /* LOGIN CARD */

        .chat-login {
            width: min(440px, 100%);

            padding: 42px;

            position: relative;

            background:
                linear-gradient(
                    145deg,
                    rgba(20,28,40,.94),
                    rgba(10,14,21,.90)
                );

            border: 1px solid var(--border);

            border-radius: 28px;

            box-shadow:
                0 35px 100px rgba(0,0,0,.55),
                inset 0 1px 0 rgba(255,255,255,.035);

            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);

            animation: cardIn .55s ease;
        }

        .chat-login::before {
            content: "";

            position: absolute;

            top: 0;
            left: 12%;
            right: 12%;

            height: 1px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(56,189,248,.7),
                    transparent
                );

            opacity: .7;
        }

        @@keyframes cardIn {

            from {
                opacity: 0;
                transform: translateY(18px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

        }

        /* LOGO */

        .logo-wrapper {
            display: flex;
            align-items: center;
            gap: 14px;

            margin-bottom: 30px;
        }

        .logo {
            width: 58px;
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 17px;

            background:
                linear-gradient(
                    135deg,
                    #1687f8,
                    #38bdf8
                );

            color: white;

            font-size: 23px;
            font-weight: 800;

            box-shadow:
                0 12px 30px rgba(22,135,248,.28);

            position: relative;
        }

        .logo::after {
            content: "";

            position: absolute;

            inset: 1px;

            border-radius: 16px;

            border: 1px solid rgba(255,255,255,.22);
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .brand-text strong {
            font-size: 15px;
            letter-spacing: .4px;
        }

        .brand-text span {
            font-size: 12px;
            color: #718096;
        }

        /* HEADING */

        h1 {
            margin: 0 0 9px;

            font-size: 30px;

            line-height: 1.15;

            letter-spacing: -.7px;
        }

        .subtitle {
            margin: 0 0 30px;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.6;
        }

        /* FORM */

        form {
            width: 100%;
        }

        .field,
        .form-group {
            margin-bottom: 20px;
        }

        .field label,
        .form-group label {
            display: block;

            margin-bottom: 9px;

            color: #cbd5e1;

            font-size: 13px;

            font-weight: 600;

            letter-spacing: .1px;
        }

        .field input,
        .form-group input {
            width: 100%;

            height: 50px;

            padding: 0 15px;

            border: 1px solid #293342;

            border-radius: 13px;

            background:
                rgba(5,9,15,.72);

            color: #fff;

            outline: none;

            font-family: inherit;

            font-size: 14px;

            transition:
                border-color .2s ease,
                box-shadow .2s ease,
                background .2s ease,
                transform .2s ease;
        }

        .field input::placeholder,
        .form-group input::placeholder {
            color: #596575;
        }

        .field input:hover,
        .form-group input:hover {
            border-color: #3a4657;

            background: rgba(7,12,19,.9);
        }

        .field input:focus,
        .form-group input:focus {
            border-color: var(--blue);

            background: rgba(7,13,21,.95);

            box-shadow:
                0 0 0 3px rgba(22,135,248,.11),
                0 8px 25px rgba(0,0,0,.18);
        }

        /* VALIDATION */

        .error {
            margin-bottom: 18px;

            padding: 11px 13px;

            border-radius: 10px;

            background: rgba(255,75,75,.07);

            border: 1px solid rgba(255,75,75,.14);

            color: #ff8585;

            font-size: 13px;

            line-height: 1.5;
        }

        .field span,
        .form-group span {
            display: block;

            margin-top: 7px;

            color: #ff7777;

            font-size: 12px;
        }

        /* BUTTON */

        .login-btn {
            width: 100%;

            height: 52px;

            margin-top: 5px;

            padding: 0 18px;

            border: 0;

            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    #1687f8,
                    #159eea
                );

            color: white;

            font-family: inherit;

            font-size: 14px;

            font-weight: 700;

            letter-spacing: .15px;

            cursor: pointer;

            position: relative;

            overflow: hidden;

            box-shadow:
                0 12px 28px rgba(22,135,248,.22);

            transition:
                transform .2s ease,
                box-shadow .2s ease,
                filter .2s ease;
        }

        .login-btn::before {
            content: "";

            position: absolute;

            top: 0;
            left: -100%;

            width: 70%;
            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(255,255,255,.16),
                    transparent
                );

            transform: skewX(-20deg);

            transition: left .55s ease;
        }

        .login-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 16px 35px rgba(22,135,248,.30);

            filter: brightness(1.05);
        }

        .login-btn:hover::before {
            left: 130%;
        }

        .login-btn:active {
            transform: translateY(0);
        }

        /* FOOTER */

       
/* FOOTER / SECURE NOTE */

.secure-note {
    margin: 24px auto 0;

    width: fit-content;
    max-width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    color: #657184;

    font-size: 11px;
    line-height: 1.4;

    letter-spacing: .2px;

    text-align: center;
    white-space: nowrap;
}

.secure-dot {
    flex: 0 0 6px;

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #31c48d;

    box-shadow:
        0 0 10px rgba(49,196,141,.5);
}



        /* MOBILE */

        @@media (max-width: 520px) {

            body {
                padding: 20px 14px;
            }

            .chat-login {
                padding: 30px 23px;

                border-radius: 22px;
            }

            h1 {
                font-size: 26px;
            }

            .logo {
                width: 54px;
                height: 54px;
            }

        }

    </style>

</head>

<body>

    <div class="chat-login">

        <div class="logo-wrapper">

            <div class="logo">
                T
            </div>

            <div class="brand-text">
                <strong>TECHNINXA</strong>
                <span>Internal Workspace</span>
            </div>

        </div>

        <h1>Company Chat</h1>

        <p class="subtitle">
            Private Techninxa communication room
        </p>

        <form method="post"
              asp-action="CompanyChatLogin">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="error">
            </div>

            <div class="field">

                <label>
                    Company Username
                </label>

                <input asp-for="Username"
                       autocomplete="username"
                       placeholder="Enter company username">

            </div>

            <div class="field">

                <label>
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Enter company password">

            </div>

            <div class="form-group">

                <label asp-for="DisplayName">
                    Your Name
                </label>

                <input asp-for="DisplayName"
                       type="text"
                       placeholder="Enter your name"
                       autocomplete="name" />

                <span asp-validation-for="DisplayName"></span>

            </div>

            <button type="submit"
                    class="login-btn">

                Enter Company Chat

            </button>

        </form>

        <div class="secure-note">

            <span class="secure-dot"></span>

            Secure internal communication

        </div>

    </div>

</body>
</html>

