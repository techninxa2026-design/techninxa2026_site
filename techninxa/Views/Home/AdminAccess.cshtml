
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["ActiveNav"] = "";
    ViewData["Description"] = "Sign in to your Techninxa account.";
}

<section class="login-section">
    <div class="container login-container">
        <div class="login-card">
              @if (TempData["LoginError"] != null)
{
    <p class="login-error-message mb-4">
        @TempData["LoginError"]
    </p>
}
            <div class="login-form-wrapper">

                <div class="login-header">
                    <span class="login-kicker">ACCOUNT ACCESS</span>

                    <h1>Welcome <span>back.</span></h1>

                    <p>
                        Sign in to continue to your Techninxa account.
                    </p>
                </div>
<form method="post" asp-action="Login" asp-controller="Home">

    <div asp-validation-summary="ModelOnly" class="login-error"></div>

    <div class="login-form-group">
        <label asp-for="Username">Username</label>

        <input asp-for="Username"
               placeholder="Enter your username"
               autocomplete="username" />

        <span asp-validation-for="Username" class="field-error"></span>
    </div>

    <div class="login-form-group">
        <label asp-for="Password">Password</label>

        <div class="password-input">
            <input asp-for="Password"
                   placeholder="Enter your password"
                   autocomplete="current-password" />

            <button type="button"
                    id="togglePassword"
                    aria-label="Show password">
                ◉
            </button>
        </div>

        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="login-options">

        <label class="remember-me">
            <input for="RememberMe" />
            <span>Remember me</span>
        </label>

        <a href="#" class="forgot-password">
            Forgot password?
        </a>

    </div>

    <button type="submit" class="login-submit">
        <span>Sign In</span>
        <strong>↗</strong>
    </button>

</form>

                <div class="login-bottom">
                    Secure access to your <span>Techninxa</span> account.
                </div>

            </div>

        </div>

    </div>
</section>

@section Styles {
    <style>
        .login-section {
            min-height: calc(100vh - 160px);
            display: flex;
            align-items: center;
            padding: 90px 0;
            position: relative;
            overflow: hidden;
        }

        .login-section::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: rgba(22, 135, 248, 0.08);
            filter: blur(100px);
            top: -220px;
            right: -180px;
            pointer-events: none;
        }

        .login-section::after {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(22, 135, 248, 0.04);
            filter: blur(100px);
            bottom: -220px;
            left: -180px;
            pointer-events: none;
        }

        .login-container {
            width: 100%;
            max-width: 620px;
            position: relative;
            z-index: 2;
        }
        .login-error-message {
    margin-top: 18px;
    padding: 12px 15px;
    border: 1px solid #fecdca;
    border-radius: 10px;
    background: #fef3f2;
    color: #b42318;
    font-size: 13px;
    font-weight: 600;
}
        .login-card {
            background: #ffffff;
            border: 1px solid #e5e9ef;
            border-radius: 28px;
            padding: 55px;
            box-shadow: 0 25px 70px rgba(11, 16, 24, 0.10);
        }

        .login-form-wrapper {
            width: 100%;
            max-width: 430px;
            margin: 0 auto;
        }

        .login-header {
            margin-bottom: 34px;
        }

        .login-kicker {
            display: inline-block;
            color: #1687f8;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.8px;
            margin-bottom: 12px;
        }

        .login-header h1 {
            font-family: "Space Grotesk", sans-serif;
            font-size: clamp(38px, 5vw, 52px);
            line-height: 1;
            letter-spacing: -2px;
            margin: 0 0 14px;
        }

        .login-header h1 span {
            color: #1687f8;
        }

        .login-header p {
            color: #667085;
            font-size: 14px;
            line-height: 1.7;
            margin: 0;
        }

        .login-form-group {
            margin-bottom: 20px;
        }

        .login-form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #0b1018;
        }

        .login-form-group input {
            width: 100%;
            height: 54px;
            border: 1px solid #e5e9ef;
            border-radius: 12px;
            background: #f8fafc;
            padding: 0 16px;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            color: #0b1018;
            outline: none;
            transition: .2s ease;
        }

        .login-form-group input::placeholder {
            color: #98a2b3;
        }

        .login-form-group input:focus {
            border-color: #1687f8;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(22, 135, 248, 0.08);
        }

        .password-input {
            position: relative;
        }

        .password-input input {
            padding-right: 52px;
        }

        .password-input button {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #98a2b3;
            font-size: 17px;
            cursor: pointer;
            padding: 5px;
            transition: .2s ease;
        }

        .password-input button:hover {
            color: #1687f8;
        }

        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 5px 0 27px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #667085;
            font-size: 13px;
            cursor: pointer;
        }

        .remember-me input {
            appearance: none;
            width: 17px;
            height: 17px;
            border: 1px solid #d0d5dd;
            border-radius: 5px;
            background: #ffffff;
            cursor: pointer;
            position: relative;
            margin: 0;
        }

        .remember-me input:checked {
            background: #1687f8;
            border-color: #1687f8;
        }

        .remember-me input:checked::after {
            content: "✓";
            position: absolute;
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            left: 3px;
            top: 0;
        }

        .forgot-password {
            color: #0b1018;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: .2s ease;
        }

        .forgot-password:hover {
            color: #1687f8;
        }

        .login-submit {
            width: 100%;
            height: 55px;
            border: none;
            border-radius: 12px;
            background: #0b1018;
            color: #ffffff;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: .25s ease;
        }

        .login-submit strong {
            color: #1687f8;
            font-size: 18px;
            transition: .25s ease;
        }

        .login-submit:hover {
            background: #1687f8;
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(22, 135, 248, 0.20);
        }

        .login-submit:hover strong {
            color: #ffffff;
            transform: translateX(4px);
        }

        .login-bottom {
            text-align: center;
            margin-top: 24px;
            color: #98a2b3;
            font-size: 12px;
        }

        .login-bottom span {
            color: #1687f8;
            font-weight: 600;
        }

        @@media (max-width: 600px) {

            .login-section {
                min-height: auto;
                padding: 55px 0;
            }

            .login-container {
                padding: 0 18px;
            }

            .login-card {
                padding: 35px 25px;
                border-radius: 22px;
            }

            .login-header h1 {
                font-size: 38px;
            }

            .login-options {
                align-items: flex-start;
                gap: 15px;
            }
        }

        @@media (max-width: 400px) {

            .login-card {
                padding: 30px 20px;
            }

            .login-options {
                flex-direction: column;
            }

            .forgot-password {
                align-self: flex-end;
            }
        }
    </style>
}

@section Scripts {
    <script>
        const password = document.getElementById("Password");
        const togglePassword = document.getElementById("togglePassword");

        togglePassword.addEventListener("click", function () {

            if (password.type === "password") {
                password.type = "text";
                togglePassword.setAttribute("aria-label", "Hide password");
            } else {
                password.type = "password";
                togglePassword.setAttribute("aria-label", "Show password");
            }

        });
    </script>
}