@using System.Text.Json
@using techninxa.Models

@{
ViewData["Title"] = "Make a Schedule";
ViewData["ActiveNav"] = "";
ViewData["Description"] = "Schedule a meeting with Techninxa.";


var holidays = ViewBag.Holidays as List<Weekday> ?? new List<Weekday>();

var holidayNumbers = holidays
    .Select(x => (int)x)
    .ToList();


}

<!DOCTYPE html>

<html lang="en">
<head>


<meta charset="utf-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<meta name="description"
      content="Schedule a meeting with Techninxa.">

<title>Make a Schedule — Techninxa</title>

<link rel="icon"
      href="/assets/techninxa-logo.png">

<link rel="preconnect"
      href="https://fonts.googleapis.com">

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet">

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        min-height: 100vh;
        background: #f7f9fc;
        color: #07111f;
        font-family: "Inter", sans-serif;
    }

    button,
    input,
    select,
    textarea {
        font-family: inherit;
    }

    button {
        cursor: pointer;
    }

    a {
        text-decoration: none;
    }

    /* ==========================================
       NAVBAR
    ========================================== */

    .schedule-nav {
        position: relative;
        z-index: 20;
        width: 100%;
        height: 82px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(15, 23, 42, 0.07);
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(18px);
    }

    .schedule-nav-inner {
        width: min(1240px, calc(100% - 40px));
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .schedule-logo img {
        width: 145px;
        height: auto;
        display: block;
    }

    .back-home {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 11px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        color: #334155;
        background: #fff;
        font-size: 13px;
        font-weight: 700;
        transition: .25s ease;
    }

    .back-home:hover {
        border-color: #38bdf8;
        color: #0284c7;
        transform: translateY(-2px);
    }

    /* ==========================================
       HERO
    ========================================== */

    .schedule-page {
        position: relative;
        min-height: calc(100vh - 82px);
        overflow: hidden;
        padding: 75px 20px 100px;
    }

    .page-glow {
        position: absolute;
        width: 600px;
        height: 600px;
        top: -250px;
        right: -180px;
        border-radius: 50%;
        background: rgba(56, 189, 248, .12);
        filter: blur(80px);
        pointer-events: none;
    }

    .page-glow-two {
        position: absolute;
        width: 400px;
        height: 400px;
        bottom: -180px;
        left: -180px;
        border-radius: 50%;
        background: rgba(14, 165, 233, .07);
        filter: blur(70px);
        pointer-events: none;
    }

    .schedule-container {
        position: relative;
        z-index: 2;
        width: min(1160px, 100%);
        margin: auto;
    }

    .schedule-heading {
        max-width: 720px;
        margin-bottom: 45px;
    }

    .schedule-kicker {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 16px;
        color: #0284c7;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .schedule-kicker::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 14px rgba(56, 189, 248, .7);
    }

    .schedule-heading h1 {
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(42px, 6vw, 72px);
        line-height: .98;
        letter-spacing: -3px;
        font-weight: 700;
        color: #07111f;
    }

    .schedule-heading h1 span {
        color: #0ea5e9;
    }

    .schedule-heading p {
        max-width: 600px;
        margin-top: 20px;
        color: #64748b;
        font-size: 15px;
        line-height: 1.8;
    }

    /* ==========================================
       MAIN BOOKING CARD
    ========================================== */

    .booking-card {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        min-height: 600px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 30px;
        background: #fff;
        box-shadow:
            0 25px 70px rgba(15, 23, 42, .08);
    }

    /* ==========================================
       CALENDAR
    ========================================== */

    .calendar-panel {
        padding: 38px;
        border-right: 1px solid #e8edf3;
    }

    .panel-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
    }

    .panel-title h2 {
        font-family: "Space Grotesk", sans-serif;
        font-size: 22px;
        letter-spacing: -.5px;
    }

    .panel-title p {
        margin-top: 5px;
        color: #94a3b8;
        font-size: 12px;
    }

    .month-navigation {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .month-button {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #fff;
        color: #334155;
        font-size: 18px;
        transition: .2s ease;
    }

    .month-button:hover {
        border-color: #38bdf8;
        color: #0284c7;
        background: #f0f9ff;
    }

    .month-label {
        min-width: 145px;
        text-align: center;
        font-family: "Space Grotesk", sans-serif;
        font-size: 16px;
        font-weight: 700;
    }

    .calendar-weekdays,
    .calendar-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 7px;
    }

    .calendar-weekdays {
        margin-bottom: 10px;
    }

    .calendar-weekdays div {
        text-align: center;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .calendar-days {
        min-height: 320px;
    }

    .calendar-day {
        position: relative;
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 13px;
        background: #f8fafc;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
    }

    .calendar-day.empty {
        background: transparent;
        pointer-events: none;
    }

    .calendar-day.available {
        cursor: pointer;
    }

    .calendar-day.available:hover {
        border-color: #7dd3fc;
        background: #f0f9ff;
        color: #0284c7;
        transform: translateY(-2px);
    }

    .calendar-day.today {
        border-color: #38bdf8;
    }

    .calendar-day.selected {
        background: #07111f;
        color: #fff;
        border-color: #07111f;
        box-shadow: 0 8px 20px rgba(7, 17, 31, .16);
    }

    .calendar-day.disabled {
        background: #f8fafc;
        color: #cbd5e1;
        cursor: not-allowed;
    }

    .calendar-day.holiday::after {
        content: "";
        position: absolute;
        width: 4px;
        height: 4px;
        bottom: 7px;
        border-radius: 50%;
        background: #cbd5e1;
    }

    .calendar-day.selected::after {
        background: #38bdf8;
    }

    .calendar-legend {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf2f7;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 10px;
        font-weight: 600;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .legend-available {
        background: #38bdf8;
    }

    .legend-holiday {
        background: #cbd5e1;
    }

    .legend-selected {
        background: #07111f;
    }

    /* ==========================================
       DETAILS PANEL
    ========================================== */

    .details-panel {
        padding: 38px;
        background:
            radial-gradient(
                circle at 100% 0%,
                rgba(56, 189, 248, .11),
                transparent 40%
            ),
            #07111f;
        color: #fff;
    }

    .details-label {
        color: #38bdf8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }

    .selected-date {
        margin-top: 9px;
        font-family: "Space Grotesk", sans-serif;
        font-size: 25px;
        font-weight: 700;
    }

    .selected-date-sub {
        margin-top: 5px;
        color: #64748b;
        font-size: 12px;
    }

    /* ==========================================
       TIME SLOTS
    ========================================== */

    .slots-section {
        margin-top: 38px;
    }

    .slots-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .slots-header h3 {
        font-size: 14px;
        font-weight: 700;
    }

    .slot-count {
        color: #64748b;
        font-size: 10px;
    }

    .slots-container {
        display: flex;
        flex-direction: column;
        gap: 9px;
        max-height: 300px;
        overflow-y: auto;
        padding-right: 3px;
    }

    .slots-container::-webkit-scrollbar {
        width: 4px;
    }

    .slots-container::-webkit-scrollbar-thumb {
        border-radius: 10px;
        background: #1e3a52;
    }

    .slot-button {
        width: 100%;
        min-height: 53px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        border: 1px solid rgba(148, 163, 184, .13);
        border-radius: 13px;
        background: rgba(255,255,255,.035);
        color: #cbd5e1;
        text-align: left;
        transition: .2s ease;
    }

    .slot-button:hover {
        border-color: rgba(56, 189, 248, .45);
        background: rgba(56, 189, 248, .07);
        color: #fff;
    }

    .slot-button.selected {
        border-color: #38bdf8;
        background: #38bdf8;
        color: #07111f;
    }

    .slot-time {
        font-size: 12px;
        font-weight: 700;
    }

    .slot-arrow {
        font-size: 15px;
        opacity: .6;
    }

    .no-slots {
        padding: 30px 15px;
        border: 1px dashed rgba(148, 163, 184, .2);
        border-radius: 14px;
        color: #64748b;
        text-align: center;
        font-size: 12px;
    }

    .choose-date-message {
        padding: 30px 15px;
        border: 1px dashed rgba(148, 163, 184, .2);
        border-radius: 14px;
        color: #64748b;
        text-align: center;
        font-size: 12px;
        line-height: 1.7;
    }

    /* ==========================================
       CONTINUE
    ========================================== */

    .continue-button {
        width: 100%;
        margin-top: 22px;
        min-height: 51px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 0;
        border-radius: 13px;
        background: #fff;
        color: #07111f;
        font-size: 13px;
        font-weight: 800;
        transition: .25s ease;
    }

    .continue-button:hover:not(:disabled) {
        background: #38bdf8;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(56, 189, 248, .2);
    }

    .continue-button:disabled {
        opacity: .35;
        cursor: not-allowed;
    }

    /* ==========================================
       FORM MODAL
    ========================================== */

    .booking-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(3, 9, 18, .72);
        backdrop-filter: blur(12px);
    }

    .booking-overlay.active {
        display: flex;
    }

    .booking-form-card {
        width: min(560px, 100%);
        max-height: 90vh;
        overflow-y: auto;
        padding: 35px;
        border-radius: 25px;
        background: #fff;
        box-shadow: 0 30px 80px rgba(0,0,0,.3);
        animation: formIn .3s ease;
    }

    @@keyframes formIn {
        from {
            opacity: 0;
            transform: translateY(20px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .form-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .form-top span {
        color: #0284c7;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .form-top h2 {
        margin-top: 6px;
        font-family: "Space Grotesk", sans-serif;
        font-size: 27px;
        letter-spacing: -.7px;
    }

    .close-form {
        width: 35px;
        height: 35px;
        flex-shrink: 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
        color: #64748b;
        font-size: 17px;
    }

    .close-form:hover {
        color: #07111f;
        border-color: #94a3b8;
    }

    .booking-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 25px;
    }

    .summary-item {
        padding: 14px;
        border-radius: 12px;
        background: #f8fafc;
    }

    .summary-item small {
        display: block;
        margin-bottom: 5px;
        color: #94a3b8;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .summary-item strong {
        color: #07111f;
        font-size: 12px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 11px;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        min-height: 46px;
        padding: 0 13px;
        outline: none;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #fff;
        color: #07111f;
        font-size: 13px;
        transition: .2s ease;
    }

    textarea.form-control {
        min-height: 105px;
        padding: 12px 13px;
        resize: vertical;
    }

    .form-control:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, .1);
    }

    .confirm-button {
        width: 100%;
        min-height: 50px;
        margin-top: 5px;
        border: 0;
        border-radius: 12px;
        background: #07111f;
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        transition: .25s ease;
    }

    .confirm-button:hover:not(:disabled) {
        background: #0ea5e9;
        transform: translateY(-2px);
    }

    .confirm-button:disabled {
        opacity: .55;
        cursor: wait;
    }

    .form-error {
        display: none;
        margin-bottom: 15px;
        padding: 11px 13px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 11px;
    }

    .form-error.show {
        display: block;
    }

    /* ==========================================
       SUCCESS
    ========================================== */

    .success-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(3, 9, 18, .78);
        backdrop-filter: blur(14px);
    }

    .success-overlay.active {
        display: flex;
    }

    .success-card {
        width: min(480px, 100%);
        padding: 45px 35px;
        border-radius: 27px;
        background: #fff;
        text-align: center;
        box-shadow: 0 35px 90px rgba(0,0,0,.35);
        animation: successIn .4s ease;
    }

    @@keyframes successIn {
        from {
            opacity: 0;
            transform: scale(.94) translateY(15px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .success-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #e0f7ff;
        color: #0284c7;
        font-size: 28px;
        font-weight: 800;
    }

    .success-card h2 {
        font-family: "Space Grotesk", sans-serif;
        font-size: 30px;
        letter-spacing: -1px;
    }

    .success-card > p {
        margin: 10px auto 25px;
        max-width: 350px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
    }

    .success-details {
        margin-bottom: 25px;
        padding: 17px;
        border-radius: 13px;
        background: #f8fafc;
    }

    .success-details strong {
        display: block;
        color: #07111f;
        font-size: 13px;
    }

    .success-details span {
        display: block;
        margin-top: 5px;
        color: #64748b;
        font-size: 11px;
    }

    .success-close {
        width: 100%;
        min-height: 48px;
        border: 0;
        border-radius: 12px;
        background: #07111f;
        color: #fff;
        font-size: 13px;
        font-weight: 800;
    }

    .success-close:hover {
        background: #0ea5e9;
    }

    /* ==========================================
       LOADING
    ========================================== */

    .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 90px;
        color: #64748b;
        font-size: 11px;
    }

    .loading-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #38bdf8;
        animation: loadingPulse 1s infinite alternate;
    }

    .loading-dot:nth-child(2) {
        animation-delay: .15s;
    }

    .loading-dot:nth-child(3) {
        animation-delay: .3s;
    }

    @@keyframes loadingPulse {
        from {
            opacity: .2;
            transform: translateY(0);
        }

        to {
            opacity: 1;
            transform: translateY(-4px);
        }
    }

    /* ==========================================
       RESPONSIVE
    ========================================== */

    @@media (max-width: 900px) {

        .booking-card {
            grid-template-columns: 1fr;
        }

        .calendar-panel {
            border-right: 0;
            border-bottom: 1px solid #e8edf3;
        }

        .details-panel {
            min-height: 500px;
        }
    }

    @@media (max-width: 600px) {

        .schedule-page {
            padding: 45px 15px 70px;
        }

        .schedule-nav {
            height: 70px;
        }

        .schedule-nav-inner {
            width: calc(100% - 30px);
        }

        .schedule-logo img {
            width: 120px;
        }

        .back-home {
            padding: 9px 12px;
            font-size: 11px;
        }

        .schedule-heading {
            margin-bottom: 30px;
        }

        .schedule-heading h1 {
            font-size: 43px;
            letter-spacing: -2px;
        }

        .calendar-panel,
        .details-panel {
            padding: 23px 18px;
        }

        .calendar-day {
            min-height: 43px;
            border-radius: 10px;
            font-size: 11px;
        }

        .calendar-weekdays div {
            font-size: 8px;
        }

        .month-label {
            min-width: 120px;
            font-size: 14px;
        }

        .booking-form-card {
            padding: 25px 20px;
        }

        .booking-summary {
            grid-template-columns: 1fr;
        }
    }

</style>


</head>

<body>


<!-- ==========================================
     NAVIGATION
========================================== -->


<!-- ==========================================
     PAGE
========================================== -->

<main class="schedule-page" style="margin-top: 50px;">

    <div class="page-glow"></div>
    <div class="page-glow-two"></div>

    <div class="schedule-container">

        <!-- HEADING -->

        <div class="schedule-heading">

            <span class="schedule-kicker">
                BOOK A MEETING
            </span>

            <h1>
                Let's find a
                <span>time.</span>
            </h1>

            <p>
                Choose a working day and a convenient time.
                Tell us a little about your project and we'll
                take it from there.
            </p>

        </div>


        <!-- ==========================================
             BOOKING CARD
        ========================================== -->

        <div class="booking-card">

            <!-- ======================================
                 CALENDAR
            ======================================= -->

            <section class="calendar-panel">

                <div class="panel-top">

                    <div class="panel-title">

                        <h2>Choose a date</h2>

                        <p>
                            Select an available working day
                        </p>

                    </div>

                    <div class="month-navigation">

                        <button type="button"
                                class="month-button"
                                id="previousMonth">
                            ‹
                        </button>

                        <button type="button"
                                class="month-button"
                                id="nextMonth">
                            ›
                        </button>

                    </div>

                </div>


                <div class="month-label"
                     id="monthLabel">
                </div>

                <div style="height:18px;"></div>


                <div class="calendar-weekdays">

                    <div>Sun</div>
                    <div>Mon</div>
                    <div>Tue</div>
                    <div>Wed</div>
                    <div>Thu</div>
                    <div>Fri</div>
                    <div>Sat</div>

                </div>


                <div class="calendar-days"
                     id="calendarDays">
                </div>


                <div class="calendar-legend">

                    <div class="legend-item">
                        <span class="legend-dot legend-available"></span>
                        Available
                    </div>

                    <div class="legend-item">
                        <span class="legend-dot legend-holiday"></span>
                        Holiday
                    </div>

                    <div class="legend-item">
                        <span class="legend-dot legend-selected"></span>
                        Selected
                    </div>

                </div>

            </section>


            <!-- ======================================
                 TIME SLOTS
            ======================================= -->

            <section class="details-panel">

                <span class="details-label">
                    Your availability
                </span>

                <div class="selected-date"
                     id="selectedDate">
                    Choose a date
                </div>

                <div class="selected-date-sub"
                     id="selectedDateSub">
                    Available meeting times will appear here.
                </div>


                <div class="slots-section">

                    <div class="slots-header">

                        <h3>
                            Available times
                        </h3>

                        <span class="slot-count"
                              id="slotCount">
                            —
                        </span>

                    </div>


                    <div class="slots-container"
                         id="slotsContainer">

                        <div class="choose-date-message">
                            Select a working day from the calendar
                            to see available time slots.
                        </div>

                    </div>

                </div>


                <button type="button"
                        class="continue-button"
                        id="continueButton"
                        disabled>

                    Continue

                    <span>↗</span>

                </button>

            </section>

        </div>

    </div>

</main>


<!-- ==========================================
     BOOKING FORM
========================================== -->

<div class="booking-overlay"
     id="bookingOverlay">

    <div class="booking-form-card">

        <div class="form-top">

            <div>

                <span>
                    ALMOST THERE
                </span>

                <h2>
                    Your meeting details
                </h2>

            </div>

            <button type="button"
                    class="close-form"
                    id="closeForm">
                ×
            </button>

        </div>


        <div class="booking-summary">

            <div class="summary-item">

                <small>Date</small>

                <strong id="formDate">
                    —
                </strong>

            </div>

            <div class="summary-item">

                <small>Time</small>

                <strong id="formTime">
                    —
                </strong>

            </div>

        </div>


        <div class="form-error"
             id="formError">
        </div>


        <form id="meetingForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="meetingDate"
                   name="meetingDate">

            <input type="hidden"
                   id="startTime"
                   name="startTime">

            <input type="hidden"
                   id="endTime"
                   name="endTime">


            <div class="form-group">

                <label for="name">
                    Name
                </label>

                <input type="text"
                       class="form-control"
                       id="name"
                       name="name"
                       placeholder="Your name"
                       maxlength="100"
                       required>

            </div>


            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       class="form-control"
                       id="email"
                       name="email"
                       placeholder="you@example.com"
                       maxlength="150"
                       required>

            </div>


            <div class="form-group">

                <label for="projectType">
                    Project Type
                </label>

                <select class="form-control"
                        id="projectType"
                        name="projectType">

                    <option value="WebDevelopment">
                        Web Development
                    </option>

                    <option value="MobileApp">
                        Mobile App
                    </option>

                    <option value="CustomSoftware">
                        Custom Software
                    </option>

                    <option value="IoTEmbedded">
                        IoT / Embedded
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>

            </div>


            <div class="form-group">

                <label for="message">
                    Tell us about your project
                </label>

                <textarea class="form-control"
                          id="message"
                          name="message"
                          maxlength="1000"
                          placeholder="A short description of your idea..."></textarea>

            </div>


            <button type="submit"
                    class="confirm-button"
                    id="confirmButton">

                Confirm Meeting ↗

            </button>

        </form>

    </div>

</div>


<!-- ==========================================
     SUCCESS
========================================== -->

<div class="success-overlay"
     id="successOverlay">

    <div class="success-card">

        <div class="success-icon">
            ✓
        </div>

        <h2>
            Meeting Confirmed
        </h2>

        <p>
            Your meeting has been successfully scheduled.
            We look forward to speaking with you.
        </p>

        <div class="success-details">

            <strong id="successDate">
                —
            </strong>

            <span id="successTime">
                —
            </span>

        </div>

        <button type="button"
                class="success-close"
                id="successClose">

            Done

        </button>

    </div>

</div>


<!-- ==========================================
     JAVASCRIPT
========================================== -->

<script>

    const holidays =
        @Html.Raw(JsonSerializer.Serialize(holidayNumbers));


    let currentDate = new Date();

    let selectedDate = null;

    let selectedSlot = null;


    /*
    ========================================================
    DOM
    ========================================================
    */

    const monthLabel =
        document.getElementById("monthLabel");

    const calendarDays =
        document.getElementById("calendarDays");

    const selectedDateElement =
        document.getElementById("selectedDate");

    const selectedDateSub =
        document.getElementById("selectedDateSub");

    const slotsContainer =
        document.getElementById("slotsContainer");

    const slotCount =
        document.getElementById("slotCount");

    const continueButton =
        document.getElementById("continueButton");

    const bookingOverlay =
        document.getElementById("bookingOverlay");

    const closeForm =
        document.getElementById("closeForm");

    const meetingForm =
        document.getElementById("meetingForm");

    const formError =
        document.getElementById("formError");

    const confirmButton =
        document.getElementById("confirmButton");

    const successOverlay =
        document.getElementById("successOverlay");

    const successClose =
        document.getElementById("successClose");


    /*
    ========================================================
    FORMAT DATE
    ========================================================
    */

    function formatDate(date) {

        return date.toLocaleDateString(
            "en-US",
            {
                weekday: "long",
                year: "numeric",
                month: "long",
                day: "numeric"
            }
        );

    }


    function formatShortDate(date) {

        const year =
            date.getFullYear();

        const month =
            String(date.getMonth() + 1)
                .padStart(2, "0");

        const day =
            String(date.getDate())
                .padStart(2, "0");

        return `${year}-${month}-${day}`;

    }


    /*
    ========================================================
    CHECK HOLIDAY
    ========================================================
    */

   function isHoliday(date) {
    const jsDay = date.getDay();

    // JavaScript: Sunday = 0 ... Saturday = 6
    // Your Weekday enum: Saturday = 0 ... Friday = 6
    const weekdayEnumValue = (jsDay + 1) % 7;

    return holidays.includes(weekdayEnumValue);
}


    /*
    ========================================================
    CHECK PAST
    ========================================================
    */

    function isPast(date) {

        const today = new Date();

        today.setHours(0, 0, 0, 0);

        return date < today;

    }


    /*
    ========================================================
    RENDER CALENDAR
    ========================================================
    */

    function renderCalendar() {

        calendarDays.innerHTML = "";

        const year =
            currentDate.getFullYear();

        const month =
            currentDate.getMonth();

        const monthName =
            currentDate.toLocaleDateString(
                "en-US",
                {
                    month: "long",
                    year: "numeric"
                }
            );

        monthLabel.textContent =
            monthName;


        const firstDay =
            new Date(
                year,
                month,
                1
            ).getDay();


        const daysInMonth =
            new Date(
                year,
                month + 1,
                0
            ).getDate();


        /*
        Empty cells
        */

        for (
            let i = 0;
            i < firstDay;
            i++
        ) {

            const empty =
                document.createElement("div");

            empty.className =
                "calendar-day empty";

            calendarDays.appendChild(empty);

        }


        /*
        Days
        */

        for (
            let day = 1;
            day <= daysInMonth;
            day++
        ) {

            const date =
                new Date(
                    year,
                    month,
                    day
                );

            const dayElement =
                document.createElement("button");

            dayElement.type =
                "button";

            dayElement.className =
                "calendar-day";

            dayElement.textContent =
                day;


            const holiday =
                isHoliday(date);

            const past =
                isPast(date);


            /*
            Today
            */

            const today =
                new Date();

            today.setHours(0, 0, 0, 0);

            if (
                date.getTime() ===
                today.getTime()
            ) {

                dayElement.classList.add("today");

            }


            /*
            Holiday
            */

            if (holiday) {

                dayElement.classList.add(
                    "disabled",
                    "holiday"
                );

                dayElement.disabled =
                    true;

            }


            /*
            Past
            */

            else if (past) {

                dayElement.classList.add(
                    "disabled"
                );

                dayElement.disabled =
                    true;

            }


            /*
            Available
            */

            else {

                dayElement.classList.add(
                    "available"
                );

                dayElement.addEventListener(
                    "click",
                    () => selectDate(date)
                );

            }


            /*
            Selected
            */

            if (
                selectedDate &&
                date.getTime() ===
                selectedDate.getTime()
            ) {

                dayElement.classList.add(
                    "selected"
                );

            }


            calendarDays.appendChild(
                dayElement
            );

        }

    }


    /*
    ========================================================
    SELECT DATE
    ========================================================
    */

    async function selectDate(date) {

        selectedDate =
            new Date(date);

        selectedSlot =
            null;

        continueButton.disabled =
            true;


        selectedDateElement.textContent =
            formatDate(date);

        selectedDateSub.textContent =
            "Checking available times...";


        slotsContainer.innerHTML = `
            <div class="loading">
                <span class="loading-dot"></span>
                <span class="loading-dot"></span>
                <span class="loading-dot"></span>
            </div>
        `;

        slotCount.textContent =
            "Loading";


        renderCalendar();


        const dateString =
            formatShortDate(date);


        try {

            const response =
                await fetch(
                    `/makeschedule/slots?date=${dateString}`
                );


            const data =
                await response.json();


            if (!data.success) {

                selectedDateSub.textContent =
                    data.message ||
                    "This day is unavailable.";

                slotsContainer.innerHTML = `
                    <div class="no-slots">
                        ${data.message || "No meetings are available on this day."}
                    </div>
                `;

                slotCount.textContent =
                    "Unavailable";

                return;

            }


            renderSlots(data.slots);

        }

        catch (error) {

            console.error(error);

            selectedDateSub.textContent =
                "Unable to load available times.";

            slotsContainer.innerHTML = `
                <div class="no-slots">
                    Something went wrong while loading
                    available times.
                </div>
            `;

            slotCount.textContent =
                "Error";

        }

    }


    /*
    ========================================================
    RENDER SLOTS
    ========================================================
    */

    function renderSlots(slots) {

        slotsContainer.innerHTML = "";

        selectedSlot = null;

        continueButton.disabled =
            true;


        if (
            !slots ||
            slots.length === 0
        ) {

            slotsContainer.innerHTML = `
                <div class="no-slots">
                    There are no available time slots
                    for this day.
                </div>
            `;

            slotCount.textContent =
                "0 available";

            selectedDateSub.textContent =
                "Please choose another working day.";

            return;

        }


        slotCount.textContent =
            `${slots.length} available`;

        selectedDateSub.textContent =
            "Choose a convenient time below.";


        slots.forEach(slot => {

            const button =
                document.createElement("button");

            button.type =
                "button";

            button.className =
                "slot-button";


            button.innerHTML = `
                <span class="slot-time">
                    ${slot.displayStart}
                    —
                    ${slot.displayEnd}
                </span>

                <span class="slot-arrow">
                    →
                </span>
            `;


            button.addEventListener(
                "click",
                () => {

                    document
                        .querySelectorAll(
                            ".slot-button"
                        )
                        .forEach(
                            item =>
                                item.classList.remove(
                                    "selected"
                                )
                        );


                    button.classList.add(
                        "selected"
                    );


                    selectedSlot =
                        slot;


                    continueButton.disabled =
                        false;

                }
            );


            slotsContainer.appendChild(
                button
            );

        });

    }


    /*
    ========================================================
    MONTH NAVIGATION
    ========================================================
    */

    document
        .getElementById("previousMonth")
        .addEventListener(
            "click",
            () => {

                const today =
                    new Date();

                today.setDate(1);


                const newMonth =
                    new Date(
                        currentDate.getFullYear(),
                        currentDate.getMonth() - 1,
                        1
                    );


                /*
                Do not navigate before
                current month
                */

                if (newMonth < today) {

                    return;

                }


                currentDate =
                    newMonth;

                renderCalendar();

            }
        );


    document
        .getElementById("nextMonth")
        .addEventListener(
            "click",
            () => {

                currentDate =
                    new Date(
                        currentDate.getFullYear(),
                        currentDate.getMonth() + 1,
                        1
                    );

                renderCalendar();

            }
        );


    /*
    ========================================================
    CONTINUE TO FORM
    ========================================================
    */

    continueButton.addEventListener(
        "click",
        () => {

            if (
                !selectedDate ||
                !selectedSlot
            ) {

                return;

            }


            document.getElementById(
                "formDate"
            ).textContent =
                formatDate(selectedDate);


            document.getElementById(
                "formTime"
            ).textContent =
                `${selectedSlot.displayStart} — ${selectedSlot.displayEnd}`;


            document.getElementById(
                "meetingDate"
            ).value =
                formatShortDate(selectedDate);


            document.getElementById(
                "startTime"
            ).value =
                selectedSlot.startTime;


            document.getElementById(
                "endTime"
            ).value =
                selectedSlot.endTime;


            formError.classList.remove(
                "show"
            );


            bookingOverlay.classList.add(
                "active"
            );

        }
    );


    /*
    ========================================================
    CLOSE FORM
    ========================================================
    */

    closeForm.addEventListener(
        "click",
        () => {

            bookingOverlay.classList.remove(
                "active"
            );

        }
    );


    /*
    ========================================================
    SUBMIT MEETING
    ========================================================
    */

    meetingForm.addEventListener(
        "submit",
        async function (event) {

            event.preventDefault();


            formError.classList.remove(
                "show"
            );


            confirmButton.disabled =
                true;

            confirmButton.textContent =
                "Booking Meeting...";


            const formData =
                new FormData(
                    meetingForm
                );


            try {

                const response =
                    await fetch(
                        "/makeschedule/book",
                        {
                            method: "POST",
                            body: formData
                        }
                    );


                const data =
                    await response.json();


                if (!data.success) {

                    formError.textContent =
                        data.message ||
                        "Unable to book this meeting.";

                    formError.classList.add(
                        "show"
                    );

                    confirmButton.disabled =
                        false;

                    confirmButton.textContent =
                        "Confirm Meeting ↗";

                    return;

                }


                /*
                SUCCESS
                */

                bookingOverlay.classList.remove(
                    "active"
                );


                document.getElementById(
                    "successDate"
                ).textContent =
                    data.meeting.date;


                document.getElementById(
                    "successTime"
                ).textContent =
                    `${data.meeting.startTime} — ${data.meeting.endTime}`;


                successOverlay.classList.add(
                    "active"
                );


                meetingForm.reset();


                confirmButton.disabled =
                    false;

                confirmButton.textContent =
                    "Confirm Meeting ↗";


                /*
                Refresh availability
                */

                if (selectedDate) {

                    await selectDate(
                        selectedDate
                    );

                }

            }

            catch (error) {

                console.error(error);

                formError.textContent =
                    "Something went wrong. Please try again.";

                formError.classList.add(
                    "show"
                );

                confirmButton.disabled =
                    false;

                confirmButton.textContent =
                    "Confirm Meeting ↗";

            }

        }
    );


    /*
    ========================================================
    SUCCESS CLOSE
    ========================================================
    */

    successClose.addEventListener(
        "click",
        () => {

            successOverlay.classList.remove(
                "active"
            );

            selectedSlot =
                null;

            continueButton.disabled =
                true;

        }
    );


    /*
    ========================================================
    CLOSE OVERLAY BY CLICKING OUTSIDE
    ========================================================
    */

    bookingOverlay.addEventListener(
        "click",
        event => {

            if (
                event.target ===
                bookingOverlay
            ) {

                bookingOverlay.classList.remove(
                    "active"
                );

            }

        }
    );


    /*
    ========================================================
    INITIALIZE
    ========================================================
    */

    renderCalendar();

</script>


</body>
</html>
